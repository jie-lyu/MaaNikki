+    CHECK(t.input->key_up(13)); // the core's ClickKey releases 50 ms later; here immediately
+    CHECK(t.platform->slept - before >= 40);
+    CHECK(t.input->key_down(13));
+    t.platform->slept += 200; // held long enough already
+    const int held = t.platform->slept;
+    CHECK(t.input->key_up(13));
+    CHECK(t.platform->slept == held);
+    t.platform->cursor_at = CGPointMake(960, 540);
+    CHECK(t.input->touch_down(1, 0, 0, HybridInput::kScenePressPressure));
+    const int scene = t.platform->slept;
+    CHECK(t.input->touch_up(1));
+    CHECK(t.platform->slept - scene >= 40);
+    CHECK(t.input->key_down(13));
+    const int stop = t.platform->slept;
+    std::thread([&] { t.input->key_up(13); }).join(); // a stop releases at once
+    CHECK(t.platform->slept == stop);
+    CHECK((t.platform->take() == Events { "key_down 13 pid=100", "key_up 13 pid=100", "key_down 13 pid=100", "key_up 13 pid=100",
+                                          "rdown@960,540", "rup@960,540", "key_down 13 pid=100", "key_up 13 pid=100" }));
+}
+
+void bare_touch_move_hovers_and_the_next_press_restores_the_users_cursor()
+{
+    Fixture t;
+    CHECK(t.input->touch_move(0, 100, 200, 0)); // hover a card to read its tooltip
+    CHECK(t.input->touch_move(0, 300, 200, 0)); // park elsewhere: the saved position stays the first one
+    CHECK(t.input->touch_down(0, 100, 200, 0));
+    CHECK(t.input->touch_up(0));
+    CHECK((t.platform->take() == Events { "move@50,100", "move@150,100", "move@50,100", "down@50,100", "up@50,100", "warp@7,7" }));
+    CHECK(t.input->touch_move(0, 100, 200, 0));
+    CHECK(t.input->inactive()); // the task ends while hovering: the cursor goes back
+    CHECK(t.input->inactive()); // once
+    CHECK((t.platform->take() == Events { "move@50,100", "warp@7,7" }));
+}
+
+void hover_is_refused_like_a_click_and_never_moves_a_held_scene_press()
+{
+    Fixture t;
+    t.platform->front = 999;
+    CHECK(!t.input->touch_move(0, 100, 200, 0));
+    t.platform->front = kGame;
+    t.platform->hit_pid = 555;
+    CHECK(!t.input->touch_move(0, 100, 200, 0));
+    t.platform->hit_pid = kGame;
+    t.platform->cursor_at = CGPointMake(960, 540);
+    CHECK(t.input->touch_down(1, 0, 0, HybridInput::kScenePressPressure));
+    CHECK(!t.input->touch_move(0, 100, 200, 0)); // the camera would turn
+    CHECK(t.input->touch_up(1));
+    CHECK((t.platform->take() == Events { "rdown@960,540", "rup@960,540" }));
+    t.platform->cursor_known = false;
+    CHECK(!t.input->touch_move(0, 100, 200, 0)); // could not be put back
+    CHECK(t.platform->take().empty());
+}
+
+void abandoned_press_after_a_hover_restores_the_users_cursor()
+{
+    Fixture t;
+    CHECK(t.input->touch_move(0, 300, 200, 0));
+    t.platform->reject_downs = true;
+    CHECK(!t.input->touch_down(0, 100, 200, 0));
+    CHECK(t.input->inactive());
+    CHECK((t.platform->take() == Events { "move@150,100", "move@50,100", "warp@7,7" })); // once, to the user's place
+}
