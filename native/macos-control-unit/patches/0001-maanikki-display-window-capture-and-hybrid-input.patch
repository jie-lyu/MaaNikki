diff --git a/source/MaaMacOSControlUnit/Base/CaptureGeometry.cpp b/source/MaaMacOSControlUnit/Base/CaptureGeometry.cpp
new file mode 100644
index 0000000..1e86efb
--- /dev/null
+++ b/source/MaaMacOSControlUnit/Base/CaptureGeometry.cpp
@@ -0,0 +1,61 @@
+#include "CaptureGeometry.h"
+
+MAA_CTRL_UNIT_NS_BEGIN
+
+DisplayMode display_mode(CGDirectDisplayID display_id)
+{
+    DisplayMode mode;
+    CGDisplayModeRef ref = CGDisplayCopyDisplayMode(display_id);
+    if (ref) {
+        mode.pixel_width = CGDisplayModeGetPixelWidth(ref);
+        mode.pixel_height = CGDisplayModeGetPixelHeight(ref);
+        CGDisplayModeRelease(ref);
+    }
+    return mode;
+}
+
+std::optional<WindowState> query_window(uint32_t window_id)
+{
+    if (window_id == 0) {
+        return std::nullopt;
+    }
+
+    CFArrayRef list = CGWindowListCopyWindowInfo(kCGWindowListOptionIncludingWindow, window_id);
+    if (!list) {
+        return std::nullopt;
+    }
+
+    std::optional<WindowState> result;
+    if (CFArrayGetCount(list) > 0) {
+        auto info = static_cast<CFDictionaryRef>(CFArrayGetValueAtIndex(list, 0));
+        WindowState state;
+
+        auto number = static_cast<CFNumberRef>(CFDictionaryGetValue(info, kCGWindowNumber));
+        uint32_t found_id = 0;
+        if (number) {
+            CFNumberGetValue(number, kCFNumberSInt32Type, &found_id);
+        }
+
+        auto pid = static_cast<CFNumberRef>(CFDictionaryGetValue(info, kCGWindowOwnerPID));
+        if (pid) {
+            CFNumberGetValue(pid, kCFNumberIntType, &state.pid);
+        }
+
+        auto bounds = static_cast<CFDictionaryRef>(CFDictionaryGetValue(info, kCGWindowBounds));
+        if (bounds) {
+            CGRectMakeWithDictionaryRepresentation(bounds, &state.bounds);
+        }
+
+        auto on_screen = static_cast<CFBooleanRef>(CFDictionaryGetValue(info, kCGWindowIsOnscreen));
+        state.on_screen = on_screen && CFBooleanGetValue(on_screen);
+
+        if (found_id == window_id && state.pid > 0) {
+            result = state;
+        }
+    }
+
+    CFRelease(list);
+    return result;
+}
+
+MAA_CTRL_UNIT_NS_END
diff --git a/source/MaaMacOSControlUnit/Base/CaptureGeometry.h b/source/MaaMacOSControlUnit/Base/CaptureGeometry.h
new file mode 100644
index 0000000..4991002
--- /dev/null
+++ b/source/MaaMacOSControlUnit/Base/CaptureGeometry.h
@@ -0,0 +1,94 @@
+#pragma once
+
+#include <mutex>
+#include <optional>
+
+#include <ApplicationServices/ApplicationServices.h>
+
+#include "Common/Conf.h"
+
+MAA_CTRL_UNIT_NS_BEGIN
+
+// Where the last captured frame sits on the desktop. Written by the
+// display-window screencap after every frame and read by the hybrid input,
+// so a click maps back through the same origin and scale as the frame it was
+// computed from, and each offset is applied exactly once.
+struct CaptureFrame
+{
+    uint32_t window_id = 0;
+    pid_t pid = -1;
+    CGDirectDisplayID display_id = 0;
+    CGRect window_bounds = CGRectZero; // CGWindowList bounds at capture time, global points
+    CGRect captured_rect = CGRectZero; // captured area, global points (top-left origin)
+    double scale = 0;                  // frame pixels per point
+    int width = 0;                     // frame size in pixels
+    int height = 0;
+    CGRect display_bounds = CGRectZero; // CGDisplayBounds at capture time
+    size_t display_pixel_width = 0;     // display mode at capture time
+    size_t display_pixel_height = 0;
+    // Consecutive published frames with this geometry. A press is refused on the first frame after
+    // a change: the click may have been computed from a frame with the previous geometry.
+    int frames_with_geometry = 0;
+};
+
+inline bool same_geometry(const CaptureFrame& a, const CaptureFrame& b)
+{
+    return a.window_id == b.window_id && a.pid == b.pid && a.display_id == b.display_id
+           && CGRectEqualToRect(CGRectIntegral(a.window_bounds), CGRectIntegral(b.window_bounds))
+           && CGRectEqualToRect(a.captured_rect, b.captured_rect) && a.scale == b.scale && a.width == b.width && a.height == b.height
+           && CGRectEqualToRect(a.display_bounds, b.display_bounds) && a.display_pixel_width == b.display_pixel_width
+           && a.display_pixel_height == b.display_pixel_height;
+}
+
+struct DisplayMode
+{
+    size_t pixel_width = 0;
+    size_t pixel_height = 0;
+
+    bool operator==(const DisplayMode&) const = default;
+};
+
+DisplayMode display_mode(CGDirectDisplayID display_id);
+
+class CaptureGeometry
+{
+public:
+    void publish(CaptureFrame frame)
+    {
+        std::lock_guard lock(mutex_);
+        frame.frames_with_geometry = previous_ && same_geometry(*previous_, frame) ? previous_->frames_with_geometry + 1 : 1;
+        frame_ = frame;
+        previous_ = frame;
+    }
+
+    // The target is gone or being rebuilt: no press may map through the old frame. The previous
+    // geometry is kept so that an identical rebuild does not count as a change.
+    void invalidate()
+    {
+        std::lock_guard lock(mutex_);
+        frame_.reset();
+    }
+
+    std::optional<CaptureFrame> latest() const
+    {
+        std::lock_guard lock(mutex_);
+        return frame_;
+    }
+
+private:
+    mutable std::mutex mutex_;
+    std::optional<CaptureFrame> frame_;
+    std::optional<CaptureFrame> previous_;
+};
+
+// CGWindowList view of one window: owner pid, global bounds in points, on-screen flag.
+struct WindowState
+{
+    pid_t pid = -1;
+    CGRect bounds = CGRectZero;
+    bool on_screen = false;
+};
+
+std::optional<WindowState> query_window(uint32_t window_id);
+
+MAA_CTRL_UNIT_NS_END
diff --git a/source/MaaMacOSControlUnit/Input/HybridInput.h b/source/MaaMacOSControlUnit/Input/HybridInput.h
new file mode 100644
index 0000000..7450533
--- /dev/null
+++ b/source/MaaMacOSControlUnit/Input/HybridInput.h
@@ -0,0 +1,94 @@
+#pragma once
+
+#include <chrono>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <thread>
+
+#include "Base/CaptureGeometry.h"
+#include "Base/UnitBase.h"
+#include "Common/Conf.h"
+
+#include <ApplicationServices/ApplicationServices.h>
+
+MAA_CTRL_UNIT_NS_BEGIN
+
+// Input profile selected by MaaMacOSInputMethod_GlobalEvent | MaaMacOSInputMethod_PostToPid,
+// each event kind on the path that a game accepts:
+//
+// - keys and text are posted to the window's process;
+// - absolute mouse events go through the global HID stream (games ignore posted clicks), at the
+//   desktop point that the last captured frame maps the pixel to, and never activate the window;
+// - relative mouse movement is a mouse-moved event with delta fields posted to the process.
+//
+// Foreground only: every press, text and relative move requires the target's process to be the
+// front application. A click additionally requires a settled frame from DisplayWindowScreencap
+// whose window and display geometry still hold, and hit-test evidence that the connected window is
+// what receives a click at that point. Otherwise nothing is sent.
+//
+// Releases only follow accepted presses, go where the press went (same point, same process), and
+// are always sent. inactive() and destruction release everything still held.
+//
+// The core calls releases from its stopping thread while its worker may be inside a press, so all
+// state is guarded by one mutex. A release that arrives from another thread for a press the unit
+// has not accepted yet cancels that press when it arrives shortly afterwards.
+class HybridInput : public InputBase
+{
+public:
+    HybridInput(uint32_t window_id, std::shared_ptr<CaptureGeometry> geometry);
+    virtual ~HybridInput() override;
+
+public: // from InputBase
+    virtual MaaControllerFeature get_features() const override;
+
+    virtual bool click(int x, int y) override;
+    virtual bool swipe(int x1, int y1, int x2, int y2, int duration) override;
+
+    virtual bool touch_down(int contact, int x, int y, int pressure) override;
+    virtual bool touch_move(int contact, int x, int y, int pressure) override;
+    virtual bool touch_up(int contact) override;
+
+    virtual bool click_key(int key) override;
+    virtual bool input_text(const std::string& text) override;
+
+    virtual bool key_down(int key) override;
+    virtual bool key_up(int key) override;
+
+    virtual bool scroll(int dx, int dy) override;
+
+    bool relative_move(int dx, int dy);
+    void release_all();
+
+private:
+    using Clock = std::chrono::steady_clock;
+
+    struct HeldContact
+    {
+        CGPoint point = CGPointZero;
+        CGMouseButton button = kCGMouseButtonLeft;
+    };
+
+    std::optional<pid_t> foreground_target(const char* action) const;
+    std::optional<CGPoint> checked_point(int x, int y, const char* action) const;
+
+    bool touch_up_locked(int contact);
+    bool key_up_locked(int key);
+
+    // A release from a foreign thread for something not held: remember it briefly.
+    void note_unmatched_release(std::map<int, Clock::time_point>& cancels, int id);
+    bool take_cancel(std::map<int, Clock::time_point>& cancels, int id);
+
+    uint32_t window_id_ = 0;
+    std::shared_ptr<CaptureGeometry> geometry_;
+
+    mutable std::mutex mutex_;
+    std::thread::id worker_;
+    std::map<int, HeldContact> held_contacts_;
+    std::map<int, pid_t> held_keys_; // key -> process the press went to
+    std::map<int, Clock::time_point> cancelled_contacts_;
+    std::map<int, Clock::time_point> cancelled_keys_;
+    CGPoint saved_cursor_ = { NAN, NAN };
+};
+
+MAA_CTRL_UNIT_NS_END
diff --git a/source/MaaMacOSControlUnit/Input/HybridInput.mm b/source/MaaMacOSControlUnit/Input/HybridInput.mm
new file mode 100644
index 0000000..8620f54
--- /dev/null
+++ b/source/MaaMacOSControlUnit/Input/HybridInput.mm
@@ -0,0 +1,468 @@
+#include "HybridInput.h"
+
+#include "InputUtils.h"
+#include "MaaUtils/Logger.h"
+
+#include <cmath>
+#include <tuple>
+#include <unistd.h>
+#include <vector>
+
+MAA_CTRL_UNIT_NS_BEGIN
+
+namespace
+{
+
+constexpr auto kCancelWindow = std::chrono::milliseconds(500);
+constexpr float kAxTimeoutSeconds = 0.25f;
+
+AXUIElementRef system_wide()
+{
+    static AXUIElementRef element = [] {
+        AXUIElementRef created = AXUIElementCreateSystemWide();
+        AXUIElementSetMessagingTimeout(created, kAxTimeoutSeconds);
+        return created;
+    }();
+    return element;
+}
+
+// The front (active) application. GetFrontProcess is deprecated but still answers from the window
+// server without a run loop; NSWorkspace.frontmostApplication goes stale in a process that does not
+// run its main loop, and the accessibility server's focused application fails for apps that do not
+// answer accessibility requests (-25204 observed with Activity Monitor in front).
+pid_t front_application_pid()
+{
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+    ProcessSerialNumber psn {};
+    pid_t pid = -1;
+    if (GetFrontProcess(&psn) != noErr || GetProcessPID(&psn, &pid) != noErr) {
+        pid = -1;
+    }
+#pragma clang diagnostic pop
+    return pid;
+}
+
+// The process whose window receives a click at this global point. The window server's hit test
+// behind it skips click-through overlays, which the window list cannot tell apart (several apps keep
+// full-screen transparent windows above everything).
+pid_t process_at_point(CGPoint point, AXError* error)
+{
+    AXUIElementRef element = nullptr;
+    *error = AXUIElementCopyElementAtPosition(system_wide(), static_cast<float>(point.x), static_cast<float>(point.y), &element);
+    if (*error != kAXErrorSuccess || !element) {
+        return -1;
+    }
+    pid_t pid = -1;
+    if (AXUIElementGetPid(element, &pid) != kAXErrorSuccess) {
+        pid = -1;
+    }
+    CFRelease(element);
+    return pid;
+}
+
+// Among the target process's own on-screen windows, the front-most one containing the point.
+// Separates the game window from the process's other windows (dialogs, helper windows).
+uint32_t front_window_of_process_at(pid_t pid, CGPoint point)
+{
+    CFArrayRef list = CGWindowListCopyWindowInfo(kCGWindowListOptionOnScreenOnly | kCGWindowListExcludeDesktopElements, kCGNullWindowID);
+    if (!list) {
+        return 0;
+    }
+    uint32_t found = 0;
+    for (CFIndex i = 0; i < CFArrayGetCount(list) && found == 0; ++i) {
+        auto info = static_cast<CFDictionaryRef>(CFArrayGetValueAtIndex(list, i));
+        pid_t owner = -1;
+        if (auto ref = static_cast<CFNumberRef>(CFDictionaryGetValue(info, kCGWindowOwnerPID))) {
+            CFNumberGetValue(ref, kCFNumberIntType, &owner);
+        }
+        if (owner != pid) {
+            continue;
+        }
+        double alpha = 1;
+        if (auto ref = static_cast<CFNumberRef>(CFDictionaryGetValue(info, kCGWindowAlpha))) {
+            CFNumberGetValue(ref, kCFNumberDoubleType, &alpha);
+        }
+        CGRect bounds = CGRectZero;
+        if (auto ref = static_cast<CFDictionaryRef>(CFDictionaryGetValue(info, kCGWindowBounds))) {
+            CGRectMakeWithDictionaryRepresentation(ref, &bounds);
+        }
+        if (alpha <= 0 || !CGRectContainsPoint(bounds, point)) {
+            continue;
+        }
+        if (auto ref = static_cast<CFNumberRef>(CFDictionaryGetValue(info, kCGWindowNumber))) {
+            CFNumberGetValue(ref, kCFNumberSInt32Type, &found);
+        }
+    }
+    CFRelease(list);
+    return found;
+}
+
+bool post_mouse(CGEventType type, CGPoint location, CGMouseButton button)
+{
+    CGEventRef event = CGEventCreateMouseEvent(nullptr, type, location, button);
+    if (!event) {
+        LogError << "failed to create mouse event";
+        return false;
+    }
+    CGEventPost(kCGHIDEventTap, event);
+    CFRelease(event);
+    return true;
+}
+
+bool post_key(pid_t pid, CGKeyCode key, bool down)
+{
+    CGEventRef event = CGEventCreateKeyboardEvent(nullptr, key, down);
+    if (!event) {
+        LogError << "failed to create keyboard event";
+        return false;
+    }
+    CGEventPostToPid(pid, event);
+    CFRelease(event);
+    return true;
+}
+
+bool valid_key(int key)
+{
+    if (key < 0 || key > 0xFFFF) {
+        LogError << "key code out of range" << VAR(key);
+        return false;
+    }
+    return true;
+}
+
+} // namespace
+
+HybridInput::HybridInput(uint32_t window_id, std::shared_ptr<CaptureGeometry> geometry)
+    : window_id_(window_id)
+    , geometry_(std::move(geometry))
+{
+}
+
+HybridInput::~HybridInput()
+{
+    release_all();
+}
+
+MaaControllerFeature HybridInput::get_features() const
+{
+    return MaaControllerFeature_UseMouseDownAndUpInsteadOfClick | MaaControllerFeature_UseKeyboardDownAndUpInsteadOfClick;
+}
+
+std::optional<pid_t> HybridInput::foreground_target(const char* action) const
+{
+    auto window = query_window(window_id_);
+    if (!window || !window->on_screen) {
+        LogError << "target window is gone or off screen, not sending" << VAR(action) << VAR(window_id_);
+        return std::nullopt;
+    }
+    pid_t front = front_application_pid();
+    if (front != window->pid) {
+        LogError << "target is not the front application, not sending" << VAR(action) << VAR(window->pid) << VAR(front);
+        return std::nullopt;
+    }
+    return window->pid;
+}
+
+std::optional<CGPoint> HybridInput::checked_point(int x, int y, const char* action) const
+{
+    auto frame = geometry_->latest();
+    if (!frame || frame->window_id != window_id_ || frame->scale <= 0) {
+        LogError << "no captured frame to map the point through, not sending" << VAR(action);
+        return std::nullopt;
+    }
+    if (frame->frames_with_geometry < 2) {
+        LogError << "geometry changed with the last frame; capture again before clicking" << VAR(action);
+        return std::nullopt;
+    }
+    if (x < 0 || y < 0 || x >= frame->width || y >= frame->height) {
+        LogError << "point outside the captured frame, not sending" << VAR(action) << VAR(x) << VAR(y) << VAR(frame->width)
+                 << VAR(frame->height);
+        return std::nullopt;
+    }
+
+    auto window = query_window(window_id_);
+    DisplayMode mode = display_mode(frame->display_id);
+    if (!window || !window->on_screen || window->pid != frame->pid
+        || !CGRectEqualToRect(CGRectIntegral(window->bounds), CGRectIntegral(frame->window_bounds))
+        || !CGRectEqualToRect(CGDisplayBounds(frame->display_id), frame->display_bounds) || mode.pixel_width != frame->display_pixel_width
+        || mode.pixel_height != frame->display_pixel_height) {
+        LogError << "window or display changed since the last frame, not sending" << VAR(action) << VAR(window.has_value());
+        return std::nullopt;
+    }
+    auto pid = foreground_target(action);
+    if (!pid) {
+        return std::nullopt;
+    }
+
+    // Frame pixel -> global point: one origin, one scale, the same ones the frame was cropped with.
+    CGPoint point = CGPointMake(frame->captured_rect.origin.x + x / frame->scale, frame->captured_rect.origin.y + y / frame->scale);
+
+    AXError error = kAXErrorSuccess;
+    pid_t owner = process_at_point(point, &error);
+    if (owner != *pid) {
+        LogError << "another process receives clicks at this point (Dock, menu bar, a window above?), not sending" << VAR(action)
+                 << VAR(point.x) << VAR(point.y) << VAR(owner) << VAR(error);
+        return std::nullopt;
+    }
+    uint32_t front = front_window_of_process_at(*pid, point);
+    if (front != window_id_) {
+        LogError << "another window of the game covers this point, not sending" << VAR(action) << VAR(point.x) << VAR(point.y) << VAR(front);
+        return std::nullopt;
+    }
+    return point;
+}
+
+void HybridInput::note_unmatched_release(std::map<int, Clock::time_point>& cancels, int id)
+{
+    // The core's own worker releases after a refused press; only a release racing in from the stopping
+    // thread may belong to a press that is about to arrive.
+    if (std::this_thread::get_id() != worker_) {
+        cancels[id] = Clock::now();
+    }
+}
+
+bool HybridInput::take_cancel(std::map<int, Clock::time_point>& cancels, int id)
+{
+    auto it = cancels.find(id);
+    if (it == cancels.end()) {
+        return false;
+    }
+    bool fresh = Clock::now() - it->second < kCancelWindow;
+    cancels.erase(it);
+    return fresh;
+}
+
+bool HybridInput::click(int x, int y)
+{
+    LogError << "use touch_down/touch_up (UseMouseDownAndUpInsteadOfClick)" << VAR(x) << VAR(y);
+    return false;
+}
+
+bool HybridInput::swipe(int x1, int y1, int x2, int y2, int duration)
+{
+    LogError << "use touch_down/touch_move/touch_up (UseMouseDownAndUpInsteadOfClick)" << VAR(x1) << VAR(y1) << VAR(x2) << VAR(y2)
+             << VAR(duration);
+    return false;
+}
+
+bool HybridInput::touch_down(int contact, int x, int y, int pressure)
+{
+    std::ignore = pressure;
+    std::lock_guard lock(mutex_);
+    worker_ = std::this_thread::get_id();
+
+    MouseEventInfo info;
+    if (!contact_to_mouse_down_info(contact, info)) {
+        LogError << "contact out of range" << VAR(contact);
+        return false;
+    }
+    if (take_cancel(cancelled_contacts_, contact)) {
+        LogWarn << "press cancelled by a stop that arrived before it" << VAR(contact);
+        return false;
+    }
+    if (held_contacts_.contains(contact)) {
+        LogError << "contact already pressed" << VAR(contact);
+        return false;
+    }
+    auto point = checked_point(x, y, "touch_down");
+    if (!point) {
+        return false;
+    }
+
+    if (held_contacts_.empty()) {
+        CGEventRef current = CGEventCreate(nullptr);
+        if (current) {
+            saved_cursor_ = CGEventGetLocation(current);
+            CFRelease(current);
+        }
+    }
+    if (!post_mouse(info.event_type, *point, info.mouse_button)) {
+        return false;
+    }
+    held_contacts_[contact] = { *point, info.mouse_button };
+    return true;
+}
+
+bool HybridInput::touch_move(int contact, int x, int y, int pressure)
+{
+    std::ignore = pressure;
+    std::lock_guard lock(mutex_);
+
+    // Only drags of an accepted press; hovering without a press is not part of this profile.
+    auto held = held_contacts_.find(contact);
+    if (held == held_contacts_.end()) {
+        LogError << "touch_move without an accepted press, not sending" << VAR(contact);
+        return false;
+    }
+    MouseEventInfo info;
+    if (!contact_to_mouse_move_info(contact, info)) {
+        LogError << "contact out of range" << VAR(contact);
+        return false;
+    }
+    auto point = checked_point(x, y, "touch_move");
+    if (!point) {
+        return false;
+    }
+    if (!post_mouse(info.event_type, *point, info.mouse_button)) {
+        return false;
+    }
+    held->second.point = *point;
+    return true;
+}
+
+bool HybridInput::touch_up(int contact)
+{
+    std::lock_guard lock(mutex_);
+    return touch_up_locked(contact);
+}
+
+bool HybridInput::touch_up_locked(int contact)
+{
+    auto held = held_contacts_.find(contact);
+    if (held == held_contacts_.end()) {
+        // Nothing was pressed (the press was refused, or has not arrived yet): send nothing.
+        note_unmatched_release(cancelled_contacts_, contact);
+        return true;
+    }
+    MouseEventInfo info;
+    contact_to_mouse_up_info(contact, info);
+    // Released where it was pressed, whatever the window or the user's cursor did since.
+    bool ok = post_mouse(info.event_type, held->second.point, held->second.button);
+    held_contacts_.erase(held);
+    if (held_contacts_.empty() && !std::isnan(saved_cursor_.x)) {
+        CGWarpMouseCursorPosition(saved_cursor_);
+        saved_cursor_ = { NAN, NAN };
+    }
+    return ok;
+}
+
+bool HybridInput::click_key(int key)
+{
+    LogError << "use key_down/key_up (UseKeyboardDownAndUpInsteadOfClick)" << VAR(key);
+    return false;
+}
+
+bool HybridInput::input_text(const std::string& text)
+{
+    std::lock_guard lock(mutex_);
+    auto pid = foreground_target("input_text");
+    if (!pid) {
+        return false;
+    }
+    std::vector<UniChar> chars;
+    if (!text_to_unichars(text, chars)) {
+        LogError << "failed to convert text" << VAR(text);
+        return false;
+    }
+    for (bool down : { true, false }) {
+        CGEventRef event = CGEventCreateKeyboardEvent(nullptr, 0, down);
+        if (!event) {
+            LogError << "failed to create keyboard event";
+            return false;
+        }
+        CGEventKeyboardSetUnicodeString(event, chars.size(), chars.data());
+        CGEventPostToPid(*pid, event);
+        CFRelease(event);
+        usleep(10000);
+    }
+    return true;
+}
+
+bool HybridInput::key_down(int key)
+{
+    std::lock_guard lock(mutex_);
+    worker_ = std::this_thread::get_id();
+    if (!valid_key(key)) {
+        return false;
+    }
+    if (take_cancel(cancelled_keys_, key)) {
+        LogWarn << "key press cancelled by a stop that arrived before it" << VAR(key);
+        return false;
+    }
+    if (held_keys_.contains(key)) {
+        return true; // already down where it was sent
+    }
+    auto pid = foreground_target("key_down");
+    if (!pid || !post_key(*pid, static_cast<CGKeyCode>(key), true)) {
+        return false;
+    }
+    held_keys_[key] = *pid;
+    return true;
+}
+
+bool HybridInput::key_up(int key)
+{
+    std::lock_guard lock(mutex_);
+    if (!valid_key(key)) {
+        return false;
+    }
+    return key_up_locked(key);
+}
+
+bool HybridInput::key_up_locked(int key)
+{
+    auto held = held_keys_.find(key);
+    if (held == held_keys_.end()) {
+        note_unmatched_release(cancelled_keys_, key);
+        return true;
+    }
+    // To the process that got the press, even if the window has closed or its id was reused since.
+    bool ok = post_key(held->second, static_cast<CGKeyCode>(key), false);
+    held_keys_.erase(held);
+    return ok;
+}
+
+bool HybridInput::scroll(int dx, int dy)
+{
+    // No validated point to scroll at in this profile yet; refuse rather than send a wheel event to
+    // whatever lies under a stale position.
+    LogError << "scroll is not supported by the hybrid input" << VAR(dx) << VAR(dy);
+    return false;
+}
+
+bool HybridInput::relative_move(int dx, int dy)
+{
+    std::lock_guard lock(mutex_);
+    auto pid = foreground_target("relative_move");
+    if (!pid) {
+        return false;
+    }
+    CGEventRef current = CGEventCreate(nullptr);
+    CGPoint location = current ? CGEventGetLocation(current) : CGPointZero;
+    if (current) {
+        CFRelease(current);
+    }
+    // Posted to the process, the cursor stays where it is and the game turns the camera.
+    CGEventRef event = CGEventCreateMouseEvent(nullptr, kCGEventMouseMoved, location, kCGMouseButtonLeft);
+    if (!event) {
+        LogError << "failed to create mouse-moved event";
+        return false;
+    }
+    CGEventSetIntegerValueField(event, kCGMouseEventDeltaX, dx);
+    CGEventSetIntegerValueField(event, kCGMouseEventDeltaY, dy);
+    CGEventPostToPid(*pid, event);
+    CFRelease(event);
+    return true;
+}
+
+void HybridInput::release_all()
+{
+    std::lock_guard lock(mutex_);
+    std::vector<int> contacts;
+    for (const auto& [contact, _] : held_contacts_) {
+        contacts.push_back(contact);
+    }
+    for (int contact : contacts) {
+        touch_up_locked(contact);
+    }
+    std::vector<int> keys;
+    for (const auto& [key, _] : held_keys_) {
+        keys.push_back(key);
+    }
+    for (int key : keys) {
+        key_up_locked(key);
+    }
+}
+
+MAA_CTRL_UNIT_NS_END
