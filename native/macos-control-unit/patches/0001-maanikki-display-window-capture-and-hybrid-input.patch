diff --git a/source/MaaMacOSControlUnit/Input/HybridInput.h b/source/MaaMacOSControlUnit/Input/HybridInput.h
new file mode 100644
index 0000000..a51e913
--- /dev/null
+++ b/source/MaaMacOSControlUnit/Input/HybridInput.h
@@ -0,0 +1,162 @@
+#pragma once
+
+#include <map>
+#include <memory>
+#include <mutex>
+#include <optional>
+#include <set>
+#include <utility>
+#include <string>
+#include <thread>
+
+#include "Base/CaptureGeometry.h"
+#include "Base/UnitBase.h"
+#include "Common/Conf.h"
+#include "Input/InputPlatform.h"
+
+#include <ApplicationServices/ApplicationServices.h>
+
+MAA_CTRL_UNIT_NS_BEGIN
+
+// Input profile selected by MaaMacOSInputMethod_GlobalEvent | MaaMacOSInputMethod_PostToPid,
+// each event kind on the path that a game accepts:
+//
+// - keys and text are posted to the window's process;
+// - absolute mouse events go through the global HID stream (games ignore posted clicks), at the
+//   desktop point that the last captured frame maps the pixel to, and never activate the window;
+//   a press first moves the cursor there and lets the hover settle (the game acts on the hovered
+//   control), then checks everything again;
+// - relative mouse movement is a mouse-moved event with delta fields posted to the process;
+// - a bare touch_move (no press held) hovers: the point is checked like a click's, the cursor moves
+//   there and stays (the agent hovers cards to read their tooltips and parks the cursor), and the
+//   user's position is put back by the next press or scroll, or by inactive()/release_all();
+// - a scroll hovers the point of the bare touch_move the core sends just before it (checked, moved,
+//   settled and checked again like a press), sends the wheel through the global HID stream in lines
+//   (120 Windows wheel units = 1 line), then puts the cursor back;
+// - a scene button (touch_down with kScenePressPressure) presses where the cursor already is.
+//
+// Foreground only: every press, text and relative move requires the target's process to be the
+// front application. A click additionally requires a settled frame from DisplayWindowScreencap
+// whose window and display geometry still hold, and hit-test evidence that the connected window is
+// what receives a click at that point. Otherwise nothing is sent.
+//
+// Releases only follow accepted presses, go where the press went (same point, same process), and
+// are always sent; one that cannot be posted stays held for the next attempt and is reported.
+// inactive() and destruction release everything still held. A press of a key the unit still counts
+// as down is posted again, so a release made behind the unit's back cannot swallow the next press.
+//
+// The core calls releases from its stopping thread while its worker may be inside a press, so all
+// state is guarded by one mutex. A release that arrives from another thread cancels the next press
+// of that key or contact whenever it arrives, even if an older press was still held (it may belong to
+// a press the core already registered); inactive(), which the core queues behind any in-flight
+// action once a task ends, clears cancellations that no press consumed. The hover before a press and
+// the check after it are made without the lock: releases from the stopping thread go out at once, and
+// one for that contact (or release_all/inactive from another thread) cancels the press, checked under
+// the lock right before the mouse-down. Any exit between the
+// hover move and an accepted press puts the cursor back; a cursor position that cannot be read
+// refuses the press before anything moves.
+//
+// Every accepted press logs one Info line with the time spent in each phase (first check, hover
+// move, settle, second check with its hit-test share, press), and every release logs its own time
+// and whether the cursor went back.
+class HybridInput : public InputBase
+{
+public:
+    // touch_down with this pressure presses a scene mouse button where the cursor already is, without
+    // the hover move: in the game scene a cursor move turns the camera. The agent sends it for ability
+    // buttons; the release is an ordinary touch_up of the same contact.
+    static constexpr int kScenePressPressure = 0x4D4E5343;
+
+    HybridInput(uint32_t window_id, std::shared_ptr<CaptureGeometry> geometry,
+                std::shared_ptr<InputPlatform> platform = system_input_platform());
+    virtual ~HybridInput() override;
+
+public: // from InputBase
+    virtual MaaControllerFeature get_features() const override;
+
+    virtual bool click(int x, int y) override;
+    virtual bool swipe(int x1, int y1, int x2, int y2, int duration) override;
+
+    virtual bool touch_down(int contact, int x, int y, int pressure) override;
+    virtual bool touch_move(int contact, int x, int y, int pressure) override;
+    virtual bool touch_up(int contact) override;
+
+    virtual bool click_key(int key) override;
+    virtual bool input_text(const std::string& text) override;
+
+    virtual bool key_down(int key) override;
+    virtual bool key_up(int key) override;
+
+    virtual bool scroll(int dx, int dy) override;
+
+    bool relative_move(int dx, int dy);
+    // Each returns false when some release could not be posted; that input stays held for a retry.
+    bool release_all();
+    // End of a task: release what is held and forget cancellations no press consumed.
+    bool inactive();
+
+private:
+    struct HeldContact
+    {
+        CGPoint point = CGPointZero;
+        CGMouseButton button = kCGMouseButtonLeft;
+        bool scene = false; // pressed where the cursor was, never moved
+        double pressed_at_ms = 0;
+    };
+
+    // Where a click check spends its time (milliseconds), for the accepted-press log line.
+    struct CheckTiming
+    {
+        double geometry_ms = 0;     // frame, window and display state, front application
+        double hit_test_ms = 0;     // accessibility hit test
+        double front_window_ms = 0; // window list: the game's front-most window at the point
+    };
+
+    std::optional<pid_t> foreground_target(const char* action) const;
+    std::optional<CGPoint> checked_point(int x, int y, const char* action, CheckTiming* timing = nullptr) const;
+    // Puts the user's cursor back and reports the outcome ("restored", "warp failed", ...).
+    std::string restore_cursor(CGPoint point);
+
+    bool scene_press(std::unique_lock<std::mutex>& lock, int contact, CGEventType type, CGMouseButton button);
+    // A release from the task's own thread waits until the press has lasted kMinHoldMs (40 ms): the game
+    // reads input once per frame and missed a 12 ms key press on the device. Releases from the stopping
+    // thread never wait.
+    void hold_at_least(std::unique_lock<std::mutex>& lock, double pressed_at_ms);
+    bool hover_locked(int x, int y);
+    // Puts the cursor back after a bare hover, unless a press or scroll took that over.
+    void end_hover_locked(const char* why);
+    bool touch_up_locked(int contact);
+    bool key_up_locked(int key);
+
+    // A release from the stopping thread: cancel the next press of that id until inactive().
+    void note_stop_release(std::set<int>& cancels, int id);
+    bool release_all_locked();
+    void cancel_pending_from_stop();
+
+    uint32_t window_id_ = 0;
+    std::shared_ptr<CaptureGeometry> geometry_;
+    std::shared_ptr<InputPlatform> platform_;
+
+    mutable std::mutex mutex_;
+    std::thread::id worker_;
+    std::map<int, HeldContact> held_contacts_;
+    std::map<int, pid_t> held_keys_; // key -> process the press went to
+    std::map<int, double> key_pressed_at_ms_; // key -> platform time of its latest accepted press
+    std::set<int> cancelled_contacts_;
+    std::set<int> cancelled_keys_;
+    CGPoint saved_cursor_ = { NAN, NAN };
+    // The contact whose press is hovering (the lock is released while the hover settles).
+    std::optional<int> pending_contact_;
+    // Frame point of the last bare touch_move (the core sends one right before scroll()): the point the
+    // next scroll hovers. Consumed by that scroll.
+    std::optional<std::pair<int, int>> scroll_target_;
+    // The user's cursor before a bare touch_move hovered it somewhere; the next press or scroll restores
+    // this position when it ends, and inactive()/release_all() restore it if nothing else did.
+    std::optional<CGPoint> hover_saved_;
+    // A scroll between its hover move and its wheel (the lock is released meanwhile); a release from
+    // another thread (a stop) cancels it.
+    bool scroll_pending_ = false;
+    bool scroll_cancelled_ = false;
+};
+
+MAA_CTRL_UNIT_NS_END
diff --git a/source/MaaMacOSControlUnit/Input/HybridInput.mm b/source/MaaMacOSControlUnit/Input/HybridInput.mm
new file mode 100644
index 0000000..308a52f
--- /dev/null
+++ b/source/MaaMacOSControlUnit/Input/HybridInput.mm
@@ -0,0 +1,715 @@
+#include "HybridInput.h"
+
+#include "InputUtils.h"
+#include "MaaUtils/Logger.h"
+
+#include <chrono>
+#include <algorithm>
+#include <cmath>
+#include <tuple>
+#include <vector>
+
+MAA_CTRL_UNIT_NS_BEGIN
+
+namespace
+{
+
+// Hover before a press; the Windows path waits 0.3 s between TouchMove and Click.
+constexpr int kHoverSettleMs = 300;
+// The settle is waited in slices so that a stop ends it early.
+constexpr int kHoverSliceMs = 10;
+
+using Clock = std::chrono::steady_clock;
+
+double ms_since(Clock::time_point start)
+{
+    return std::chrono::duration<double, std::milli>(Clock::now() - start).count();
+}
+
+// Windows wheel units (120 per notch) to lines; any non-zero amount moves at least one line.
+int wheel_lines(int amount)
+{
+    if (amount == 0) {
+        return 0;
+    }
+    int lines = amount / 120;
+    return lines != 0 ? lines : (amount > 0 ? 1 : -1);
+}
+
+// Shortest key or scene-button press: longer than a frame at 30 fps (33 ms); the game missed a 12 ms
+// press on the device. Kept low because the navigation engine's micro-turns pulse for 28 ms and up.
+constexpr int kMinHoldMs = 40;
+
+// Time for the window server to route a posted wheel to the window under the cursor before the
+// cursor is moved back.
+constexpr int kWheelDeliveryMs = 50;
+
+bool valid_key(int key)
+{
+    if (key < 0 || key > 0xFFFF) {
+        LogError << "key code out of range" << VAR(key);
+        return false;
+    }
+    return true;
+}
+
+} // namespace
+
+HybridInput::HybridInput(uint32_t window_id, std::shared_ptr<CaptureGeometry> geometry, std::shared_ptr<InputPlatform> platform)
+    : window_id_(window_id)
+    , geometry_(std::move(geometry))
+    , platform_(std::move(platform))
+{
+}
+
+HybridInput::~HybridInput()
+{
+    release_all();
+}
+
+MaaControllerFeature HybridInput::get_features() const
+{
+    return MaaControllerFeature_UseMouseDownAndUpInsteadOfClick | MaaControllerFeature_UseKeyboardDownAndUpInsteadOfClick;
+}
+
+std::optional<pid_t> HybridInput::foreground_target(const char* action) const
+{
+    auto window = platform_->window(window_id_);
+    if (!window || !window->on_screen) {
+        LogError << "target window is gone or off screen, not sending" << VAR(action) << VAR(window_id_);
+        return std::nullopt;
+    }
+    pid_t front = platform_->front_pid();
+    if (front != window->pid) {
+        LogError << "target is not the front application, not sending" << VAR(action) << VAR(window->pid) << VAR(front);
+        return std::nullopt;
+    }
+    return window->pid;
+}
+
+std::optional<CGPoint> HybridInput::checked_point(int x, int y, const char* action, CheckTiming* timing) const
+{
+    const auto started = Clock::now();
+    auto frame = geometry_->latest();
+    if (!frame || frame->window_id != window_id_ || frame->scale <= 0) {
+        LogError << "no captured frame to map the point through, not sending" << VAR(action);
+        return std::nullopt;
+    }
+    if (frame->geometry_changed) {
+        LogError << "window or display geometry changed since connect; reconnect before clicking" << VAR(action);
+        return std::nullopt;
+    }
+    if (x < 0 || y < 0 || x >= frame->width || y >= frame->height) {
+        LogError << "point outside the captured frame, not sending" << VAR(action) << VAR(x) << VAR(y) << VAR(frame->width)
+                 << VAR(frame->height);
+        return std::nullopt;
+    }
+
+    auto window = platform_->window(window_id_);
+    DisplayMode mode = platform_->display_mode(frame->display_id);
+    if (!window || !window->on_screen || window->pid != frame->pid
+        || !CGRectEqualToRect(CGRectIntegral(window->bounds), CGRectIntegral(frame->window_bounds))
+        || !CGRectEqualToRect(platform_->display_bounds(frame->display_id), frame->display_bounds) || mode.pixel_width != frame->display_pixel_width
+        || mode.pixel_height != frame->display_pixel_height) {
+        LogError << "window or display changed since the last frame, not sending" << VAR(action) << VAR(window.has_value());
+        return std::nullopt;
+    }
+    auto pid = foreground_target(action);
+    if (!pid) {
+        return std::nullopt;
+    }
+
+    // Frame pixel -> global point: one origin, one scale, the same ones the frame was cropped with.
+    CGPoint point = CGPointMake(frame->captured_rect.origin.x + x / frame->scale, frame->captured_rect.origin.y + y / frame->scale);
+    if (timing) {
+        timing->geometry_ms = ms_since(started);
+    }
+
+    int error = 0;
+    const auto hit_started = Clock::now();
+    pid_t owner = platform_->process_at(point, &error);
+    if (timing) {
+        timing->hit_test_ms = ms_since(hit_started);
+    }
+    if (owner != *pid) {
+        LogError << "another process receives clicks at this point (Dock, menu bar, a window above?), not sending" << VAR(action)
+                 << VAR(point.x) << VAR(point.y) << VAR(owner) << VAR(error);
+        return std::nullopt;
+    }
+    const auto list_started = Clock::now();
+    uint32_t front = platform_->front_window_of_process_at(*pid, point);
+    if (timing) {
+        timing->front_window_ms = ms_since(list_started);
+    }
+    if (front != window_id_) {
+        LogError << "another window of the game covers this point, not sending" << VAR(action) << VAR(point.x) << VAR(point.y) << VAR(front);
+        return std::nullopt;
+    }
+    // The hit test may block; the user can switch apps meanwhile. Check the front app once more last.
+    if (platform_->front_pid() != *pid) {
+        LogError << "target left the front during the checks, not sending" << VAR(action);
+        return std::nullopt;
+    }
+    return point;
+}
+
+void HybridInput::note_stop_release(std::set<int>& cancels, int id)
+{
+    // The core's own worker releases after a refused press and in inactive(); only a release from
+    // another thread (the core's stop) may belong to a press that is about to arrive. It stays until
+    // that press consumes it or inactive() ends the task.
+    if (std::this_thread::get_id() != worker_) {
+        cancels.insert(id);
+        scroll_cancelled_ = scroll_cancelled_ || scroll_pending_;
+    }
+}
+
+std::string HybridInput::restore_cursor(CGPoint point)
+{
+    if (!platform_->warp_cursor(point)) {
+        return "warp failed";
+    }
+    auto now = platform_->cursor();
+    if (!now) {
+        return "warped, position unreadable";
+    }
+    if (std::fabs(now->x - point.x) > 1 || std::fabs(now->y - point.y) > 1) {
+        return "warped, cursor elsewhere";
+    }
+    return "restored";
+}
+
+bool HybridInput::click(int x, int y)
+{
+    LogError << "use touch_down/touch_up (UseMouseDownAndUpInsteadOfClick)" << VAR(x) << VAR(y);
+    return false;
+}
+
+bool HybridInput::swipe(int x1, int y1, int x2, int y2, int duration)
+{
+    LogError << "use touch_down/touch_move/touch_up (UseMouseDownAndUpInsteadOfClick)" << VAR(x1) << VAR(y1) << VAR(x2) << VAR(y2)
+             << VAR(duration);
+    return false;
+}
+
+bool HybridInput::touch_down(int contact, int x, int y, int pressure)
+{
+    const auto started = Clock::now();
+    std::unique_lock lock(mutex_);
+    worker_ = std::this_thread::get_id();
+
+    MouseEventInfo info;
+    if (!contact_to_mouse_down_info(contact, info)) {
+        LogError << "contact out of range" << VAR(contact);
+        return false;
+    }
+    if (cancelled_contacts_.erase(contact)) {
+        LogWarn << "press cancelled by a stop that arrived before it" << VAR(contact);
+        return false;
+    }
+    if (held_contacts_.contains(contact)) {
+        LogError << "contact already pressed" << VAR(contact);
+        return false;
+    }
+    if (pressure == kScenePressPressure) {
+        return scene_press(lock, contact, info.event_type, info.mouse_button);
+    }
+    auto phase = Clock::now();
+    CheckTiming first;
+    auto point = checked_point(x, y, "touch_down", &first);
+    const double first_check_ms = ms_since(phase);
+    if (!point) {
+        return false;
+    }
+
+    // The first press moves the user's cursor; it must be put back however the press ends, so a
+    // position that cannot be read means no press at all.
+    const bool restore = held_contacts_.empty();
+    CGPoint original = { NAN, NAN };
+    if (restore) {
+        // After a bare hover the user's position is the one saved before it.
+        auto cursor = hover_saved_ ? hover_saved_ : platform_->cursor();
+        if (!cursor) {
+            LogError << "cursor position unknown, cannot restore it afterwards; not sending" << VAR(contact);
+            return false;
+        }
+        original = *cursor;
+    }
+    // Every exit after the hover move and before an accepted press.
+    auto abandon = [&](const char* why) {
+        std::string restored = "not moved back (another contact is held)";
+        if (restore && held_contacts_.empty()) {
+            restored = restore_cursor(original);
+            hover_saved_.reset();
+        }
+        LogWarn << "press abandoned after the hover" << VAR(contact) << VAR(why) << VAR(restored);
+        return false;
+    };
+
+    // The game acts on the control under its hover position, not on the location carried by the
+    // press: move there and let the hover settle first, as the Windows path does (TouchMove, 0.3 s).
+    phase = Clock::now();
+    pending_contact_ = contact;
+    if (!platform_->post_mouse(kCGEventMouseMoved, *point, info.mouse_button)) {
+        pending_contact_.reset();
+        return abandon("hover move not posted");
+    }
+    const double move_ms = ms_since(phase);
+    // Settle without the lock, so that a stop's releases (a held key, this very press) are sent at
+    // once instead of waiting behind the press; any of them cancels this press.
+    phase = Clock::now();
+    // Up to a deadline rather than a count of slices: sleeps overshoot, 30 x 10 ms took ~350 ms.
+    const double deadline = platform_->now_ms() + kHoverSettleMs;
+    for (double remaining = kHoverSettleMs; remaining > 0 && !cancelled_contacts_.contains(contact);
+         remaining = deadline - platform_->now_ms()) {
+        lock.unlock();
+        platform_->sleep_ms(std::max(1, std::min(kHoverSliceMs, static_cast<int>(std::ceil(remaining)))));
+        lock.lock();
+    }
+    const double settle_ms = ms_since(phase);
+    if (cancelled_contacts_.erase(contact)) {
+        pending_contact_.reset();
+        return abandon("cancelled by a stop during the hover");
+    }
+    // Everything may have changed while settling: check again right before pressing. The check reads
+    // no state this lock guards and its hit test can block, so it runs unlocked like the settle: a
+    // stop meanwhile is sent at once and cancels the press, seen under the lock just below.
+    phase = Clock::now();
+    CheckTiming second;
+    lock.unlock();
+    auto settled = checked_point(x, y, "touch_down", &second);
+    lock.lock();
+    const double second_check_ms = ms_since(phase);
+    pending_contact_.reset();
+    if (cancelled_contacts_.erase(contact)) {
+        return abandon("cancelled by a stop during the second check");
+    }
+    if (!settled) {
+        return abandon("second check refused");
+    }
+    phase = Clock::now();
+    if (!platform_->post_mouse(info.event_type, *settled, info.mouse_button)) {
+        return abandon("mouse-down not posted");
+    }
+    const double press_ms = ms_since(phase);
+    if (restore) {
+        saved_cursor_ = original;
+        hover_saved_.reset(); // the release puts the cursor back now
+    }
+    held_contacts_[contact] = { *settled, info.mouse_button };
+    LogInfo << "hover settled, press accepted" << VAR(contact) << VAR(settled->x) << VAR(settled->y) << VAR(first_check_ms)
+            << VAR(first.geometry_ms) << VAR(first.hit_test_ms) << VAR(first.front_window_ms) << VAR(move_ms) << VAR(settle_ms)
+            << VAR(second_check_ms) << VAR(second.geometry_ms) << VAR(second.hit_test_ms) << VAR(second.front_window_ms) << VAR(press_ms)
+            << "total_ms=" << ms_since(started);
+    return true;
+}
+
+bool HybridInput::scene_press(std::unique_lock<std::mutex>& lock, int contact, CGEventType type, CGMouseButton button)
+{
+    const auto started = Clock::now();
+    // The checks ask the accessibility server and may block: run them unlocked, as a click's are, so
+    // that a stop's releases go out at once and cancel this press (seen under the lock below).
+    pending_contact_ = contact;
+    lock.unlock();
+    auto checked = [&]() -> std::optional<CGPoint> {
+        auto frame = geometry_->latest();
+        if (frame && frame->geometry_changed) {
+            LogError << "window or display geometry changed since connect; reconnect before pressing" << VAR(contact);
+            return std::nullopt;
+        }
+        auto pid = foreground_target("scene_press");
+        if (!pid) {
+            return std::nullopt;
+        }
+        // Where the cursor already is: in the scene the game hides it and turns the camera on any move.
+        auto cursor = platform_->cursor();
+        if (!cursor) {
+            LogError << "cursor position unknown, not sending" << VAR(contact);
+            return std::nullopt;
+        }
+        auto window = platform_->window(window_id_);
+        if (!window || window->pid != *pid || !CGRectContainsPoint(window->bounds, *cursor)) {
+            LogError << "cursor is not over the game window, not sending" << VAR(contact) << VAR(cursor->x) << VAR(cursor->y);
+            return std::nullopt;
+        }
+        int error = 0;
+        pid_t owner = platform_->process_at(*cursor, &error);
+        if (owner != *pid) {
+            LogError << "another process receives clicks at the cursor, not sending" << VAR(contact) << VAR(owner) << VAR(error);
+            return std::nullopt;
+        }
+        if (platform_->front_window_of_process_at(*pid, *cursor) != window_id_) {
+            LogError << "another window of the game covers the cursor, not sending" << VAR(contact);
+            return std::nullopt;
+        }
+        if (platform_->front_pid() != *pid) {
+            LogError << "target left the front during the checks, not sending" << VAR(contact);
+            return std::nullopt;
+        }
+        return cursor;
+    }();
+    lock.lock();
+    pending_contact_.reset();
+    if (cancelled_contacts_.erase(contact)) {
+        LogWarn << "scene press cancelled by a stop during its checks" << VAR(contact);
+        return false;
+    }
+    if (!checked || !platform_->post_mouse(type, *checked, button)) {
+        return false;
+    }
+    held_contacts_[contact] = { *checked, button, true, platform_->now_ms() };
+    LogInfo << "scene press accepted" << VAR(contact) << VAR(checked->x) << VAR(checked->y) << "total_ms=" << ms_since(started);
+    return true;
+}
+
+bool HybridInput::touch_move(int contact, int x, int y, int pressure)
+{
+    std::ignore = pressure;
+    std::lock_guard lock(mutex_);
+
+    // Drags only follow an accepted press. A bare touch_move moves nothing: the core sends one to "move
+    // to the scroll position" right before scroll(), which hovers that point itself.
+    auto held = held_contacts_.find(contact);
+    if (held == held_contacts_.end()) {
+        return hover_locked(x, y);
+    }
+    if (held->second.scene) {
+        // A scene button never drags: moving the cursor in the scene turns the camera.
+        LogError << "touch_move of a scene press, not sending" << VAR(contact);
+        return false;
+    }
+    MouseEventInfo info;
+    if (!contact_to_mouse_move_info(contact, info)) {
+        LogError << "contact out of range" << VAR(contact);
+        return false;
+    }
+    auto point = checked_point(x, y, "touch_move");
+    if (!point) {
+        return false;
+    }
+    if (!platform_->post_mouse(info.event_type, *point, info.mouse_button)) {
+        return false;
+    }
+    held->second.point = *point;
+    return true;
+}
+
+void HybridInput::hold_at_least(std::unique_lock<std::mutex>& lock, double pressed_at_ms)
+{
+    if (std::this_thread::get_id() != worker_) {
+        return;
+    }
+    const double remaining = pressed_at_ms + kMinHoldMs - platform_->now_ms();
+    if (remaining > 0) {
+        lock.unlock();
+        platform_->sleep_ms(static_cast<int>(std::ceil(remaining)));
+        lock.lock();
+    }
+}
+
+bool HybridInput::hover_locked(int x, int y)
+{
+    scroll_target_ = std::make_pair(x, y);
+    if (!held_contacts_.empty()) {
+        // A held button (a scene press) would turn the camera if the cursor moved.
+        LogError << "hover while a mouse button is held, not moving" << VAR(x) << VAR(y);
+        return false;
+    }
+    auto point = checked_point(x, y, "hover");
+    if (!point) {
+        return false;
+    }
+    if (!hover_saved_) {
+        auto cursor = platform_->cursor();
+        if (!cursor) {
+            LogError << "cursor position unknown, cannot restore it afterwards; not moving" << VAR(x) << VAR(y);
+            return false;
+        }
+        hover_saved_ = *cursor;
+    }
+    if (!platform_->post_mouse(kCGEventMouseMoved, *point, kCGMouseButtonLeft)) {
+        return false;
+    }
+    LogInfo << "hover moved" << VAR(point->x) << VAR(point->y);
+    return true;
+}
+
+void HybridInput::end_hover_locked(const char* why)
+{
+    if (hover_saved_ && held_contacts_.empty()) {
+        std::string restored = restore_cursor(*hover_saved_);
+        hover_saved_.reset();
+        LogInfo << "hover ended" << VAR(why) << VAR(restored);
+    }
+}
+
+bool HybridInput::touch_up(int contact)
+{
+    std::unique_lock lock(mutex_);
+    // Scene buttons are pulsed by the agent (50 ms by default): give the game a frame to see them.
+    // A click's press already lasted the hover settle and the core's own 50 ms.
+    if (auto held = held_contacts_.find(contact); held != held_contacts_.end() && held->second.scene) {
+        hold_at_least(lock, held->second.pressed_at_ms);
+    }
+    return touch_up_locked(contact);
+}
+
+bool HybridInput::touch_up_locked(int contact)
+{
+    // A release from the stopping thread may belong to a press still on its way, whether or not an
+    // older press of the same contact is held: cancel that next press either way.
+    note_stop_release(cancelled_contacts_, contact);
+    auto held = held_contacts_.find(contact);
+    if (held == held_contacts_.end()) {
+        // Nothing was pressed (the press was refused, or has not arrived yet): send nothing.
+        return true;
+    }
+    MouseEventInfo info;
+    contact_to_mouse_up_info(contact, info);
+    const auto started = Clock::now();
+    // Released where it was pressed, whatever the window or the user's cursor did since.
+    if (!platform_->post_mouse(info.event_type, held->second.point, held->second.button)) {
+        // Still down as far as anyone knows: keep it for the next release attempt.
+        LogError << "mouse-up could not be posted; the contact stays held" << VAR(contact);
+        return false;
+    }
+    const double release_ms = ms_since(started);
+    const bool scene = held->second.scene;
+    held_contacts_.erase(held);
+    std::string cursor = "not moved back (another contact is held)";
+    double restore_ms = 0;
+    if (held_contacts_.empty()) {
+        if (std::isnan(saved_cursor_.x)) {
+            cursor = scene ? "never moved (scene press)" : "no saved position";
+        }
+        else {
+            const auto restore_started = Clock::now();
+            cursor = restore_cursor(saved_cursor_);
+            restore_ms = ms_since(restore_started);
+            saved_cursor_ = { NAN, NAN };
+        }
+    }
+    LogInfo << "release posted" << VAR(contact) << VAR(release_ms) << VAR(restore_ms) << VAR(cursor);
+    return true;
+}
+
+bool HybridInput::click_key(int key)
+{
+    LogError << "use key_down/key_up (UseKeyboardDownAndUpInsteadOfClick)" << VAR(key);
+    return false;
+}
+
+bool HybridInput::input_text(const std::string& text)
+{
+    std::lock_guard lock(mutex_);
+    auto pid = foreground_target("input_text");
+    if (!pid) {
+        return false;
+    }
+    std::vector<UniChar> chars;
+    if (!text_to_unichars(text, chars)) {
+        LogError << "failed to convert text" << VAR(text);
+        return false;
+    }
+    return platform_->post_text(*pid, chars);
+}
+
+bool HybridInput::key_down(int key)
+{
+    std::lock_guard lock(mutex_);
+    worker_ = std::this_thread::get_id();
+    if (!valid_key(key)) {
+        return false;
+    }
+    if (cancelled_keys_.erase(key)) {
+        LogWarn << "key press cancelled by a stop that arrived before it" << VAR(key);
+        return false;
+    }
+    auto pid = foreground_target("key_down");
+    if (!pid) {
+        return false;
+    }
+    auto held = held_keys_.find(key);
+    if (held != held_keys_.end() && held->second != *pid) {
+        // The window now belongs to another process; keep the recorded owner for the release.
+        LogError << "key is still held for another process, not sending" << VAR(key) << VAR(held->second) << VAR(*pid);
+        return false;
+    }
+    // A key this unit still counts as down may have been released behind its back (the agent posts
+    // releases straight to the game when the controller channel fails). Post the press again rather
+    // than report a press that sent nothing; a repeated key-down is harmless to the game.
+    if (!platform_->post_key(*pid, static_cast<CGKeyCode>(key), true)) {
+        return false;
+    }
+    held_keys_.emplace(key, *pid);
+    key_pressed_at_ms_[key] = platform_->now_ms();
+    return true;
+}
+
+bool HybridInput::key_up(int key)
+{
+    std::unique_lock lock(mutex_);
+    if (!valid_key(key)) {
+        return false;
+    }
+    // The core releases a ClickKey 50 ms after its press.
+    if (auto pressed = key_pressed_at_ms_.find(key); pressed != key_pressed_at_ms_.end() && held_keys_.contains(key)) {
+        hold_at_least(lock, pressed->second);
+    }
+    return key_up_locked(key);
+}
+
+bool HybridInput::key_up_locked(int key)
+{
+    note_stop_release(cancelled_keys_, key);
+    auto held = held_keys_.find(key);
+    if (held == held_keys_.end()) {
+        return true;
+    }
+    // To the process that got the press, even if the window has closed or its id was reused since.
+    if (!platform_->post_key(held->second, static_cast<CGKeyCode>(key), false)) {
+        LogError << "key-up could not be posted; the key stays held" << VAR(key);
+        return false;
+    }
+    held_keys_.erase(held);
+    return true;
+}
+
+bool HybridInput::scroll(int dx, int dy)
+{
+    const auto started = Clock::now();
+    std::unique_lock lock(mutex_);
+    worker_ = std::this_thread::get_id();
+    auto target = std::exchange(scroll_target_, std::nullopt);
+    if (!target) {
+        LogError << "scroll without a position (the core moves to it first), not sending" << VAR(dx) << VAR(dy);
+        return false;
+    }
+    const int lines_y = wheel_lines(dy);
+    const int lines_x = wheel_lines(dx);
+    if (lines_y == 0 && lines_x == 0) {
+        return true;
+    }
+    if (!held_contacts_.empty() || !held_keys_.empty()) {
+        // A held modifier would turn the wheel into something else (zoom, sideways).
+        LogError << "scroll while a key or mouse button is held, not sending" << VAR(dx) << VAR(dy);
+        return false;
+    }
+    CheckTiming first;
+    auto point = checked_point(target->first, target->second, "scroll", &first);
+    if (!point) {
+        return false;
+    }
+    auto original = hover_saved_ ? hover_saved_ : platform_->cursor();
+    if (!original) {
+        LogError << "cursor position unknown, cannot restore it afterwards; not sending" << VAR(dx) << VAR(dy);
+        return false;
+    }
+    hover_saved_.reset(); // this scroll puts the cursor back when it ends
+    auto finish = [&](const char* why) {
+        std::string restored = held_contacts_.empty() ? restore_cursor(*original) : "not moved back (a contact is held)";
+        LogWarn << "scroll abandoned after the hover" << VAR(why) << VAR(restored);
+        return false;
+    };
+    // The game scrolls the list under its hover position: move there and let the hover settle, as a
+    // press does. Unlocked while settling and checking so that a stop's releases go out at once; a
+    // release from another thread meanwhile cancels the scroll. The core may give a stop during a
+    // scroll no signal at all (nothing is held then, so it has nothing to release).
+    if (!platform_->post_mouse(kCGEventMouseMoved, *point, kCGMouseButtonLeft)) {
+        return finish("hover move not posted");
+    }
+    scroll_pending_ = true;
+    scroll_cancelled_ = false;
+    const double deadline = platform_->now_ms() + kHoverSettleMs;
+    for (double remaining = kHoverSettleMs; remaining > 0 && !scroll_cancelled_; remaining = deadline - platform_->now_ms()) {
+        lock.unlock();
+        platform_->sleep_ms(std::max(1, std::min(kHoverSliceMs, static_cast<int>(std::ceil(remaining)))));
+        lock.lock();
+    }
+    if (scroll_cancelled_) {
+        // Cancelled while settling: put the cursor back now instead of after another hit test.
+        scroll_pending_ = scroll_cancelled_ = false;
+        return finish("cancelled by a stop during the hover");
+    }
+    CheckTiming second;
+    lock.unlock();
+    auto settled = checked_point(target->first, target->second, "scroll", &second);
+    lock.lock();
+    scroll_pending_ = false;
+    if (std::exchange(scroll_cancelled_, false)) {
+        return finish("cancelled by a stop during the second check");
+    }
+    if (!settled) {
+        return finish("second check refused");
+    }
+    if (!platform_->post_scroll(*settled, lines_y, lines_x)) {
+        return finish("wheel not posted");
+    }
+    lock.unlock();
+    platform_->sleep_ms(kWheelDeliveryMs);
+    lock.lock();
+    std::string restored = held_contacts_.empty() ? restore_cursor(*original) : "not moved back (a contact is held)";
+    LogInfo << "scroll posted" << VAR(lines_y) << VAR(lines_x) << VAR(settled->x) << VAR(settled->y) << VAR(first.hit_test_ms)
+            << VAR(second.hit_test_ms) << VAR(restored) << "total_ms=" << ms_since(started);
+    return true;
+}
+
+bool HybridInput::relative_move(int dx, int dy)
+{
+    std::lock_guard lock(mutex_);
+    auto pid = foreground_target("relative_move");
+    return pid && platform_->post_relative_move(*pid, dx, dy);
+}
+
+bool HybridInput::release_all()
+{
+    std::lock_guard lock(mutex_);
+    bool released = release_all_locked();
+    cancel_pending_from_stop();
+    end_hover_locked("release_all");
+    return released;
+}
+
+bool HybridInput::inactive()
+{
+    std::lock_guard lock(mutex_);
+    bool released = release_all_locked();
+    cancelled_contacts_.clear();
+    cancelled_keys_.clear();
+    cancel_pending_from_stop();
+    end_hover_locked("inactive");
+    return released;
+}
+
+void HybridInput::cancel_pending_from_stop()
+{
+    // Releasing everything from another thread while a press hovers: that press must not follow.
+    if (std::this_thread::get_id() != worker_) {
+        if (pending_contact_) {
+            cancelled_contacts_.insert(*pending_contact_);
+        }
+        scroll_cancelled_ = scroll_cancelled_ || scroll_pending_;
+    }
+}
+
+bool HybridInput::release_all_locked()
+{
+    bool released = true;
+    std::vector<int> contacts;
+    for (const auto& [contact, _] : held_contacts_) {
+        contacts.push_back(contact);
+    }
+    for (int contact : contacts) {
+        released = touch_up_locked(contact) && released;
+    }
+    std::vector<int> keys;
+    for (const auto& [key, _] : held_keys_) {
+        keys.push_back(key);
+    }
+    for (int key : keys) {
+        released = key_up_locked(key) && released;
+    }
+    return released;
+}
+
+MAA_CTRL_UNIT_NS_END
diff --git a/source/MaaMacOSControlUnit/Input/InputPlatform.h b/source/MaaMacOSControlUnit/Input/InputPlatform.h
new file mode 100644
index 0000000..2f3f97e
--- /dev/null
+++ b/source/MaaMacOSControlUnit/Input/InputPlatform.h
@@ -0,0 +1,47 @@
+#pragma once
+
+#include <memory>
+#include <optional>
+#include <vector>
+
+#include <ApplicationServices/ApplicationServices.h>
+
+#include "Base/CaptureGeometry.h"
+#include "Common/Conf.h"
+
+MAA_CTRL_UNIT_NS_BEGIN
+
+// Everything HybridInput asks of the desktop or sends to it. The system implementation wraps
+// CoreGraphics, the accessibility API and the Process Manager; tests substitute a fake to drive
+// orderings (a stop racing a press) that cannot be produced reliably on a real desktop.
+class InputPlatform
+{
+public:
+    virtual ~InputPlatform() = default;
+
+    virtual std::optional<WindowState> window(uint32_t window_id) = 0;
+    virtual pid_t front_pid() = 0;
+    // The process a click at this global point reaches (accessibility hit test); -1 with error set otherwise.
+    virtual pid_t process_at(CGPoint point, int* error) = 0;
+    // Among pid's on-screen windows, the front-most one containing the point; 0 if none.
+    virtual uint32_t front_window_of_process_at(pid_t pid, CGPoint point) = 0;
+    virtual CGRect display_bounds(CGDirectDisplayID display_id) = 0;
+    virtual DisplayMode display_mode(CGDirectDisplayID display_id) = 0;
+
+    virtual bool post_mouse(CGEventType type, CGPoint location, CGMouseButton button) = 0;
+    // A wheel event in lines (positive: up / left), through the global HID stream at this point.
+    virtual bool post_scroll(CGPoint location, int lines_y, int lines_x) = 0;
+    virtual bool post_key(pid_t pid, CGKeyCode key, bool down) = 0;
+    virtual bool post_text(pid_t pid, const std::vector<UniChar>& chars) = 0;
+    virtual bool post_relative_move(pid_t pid, int dx, int dy) = 0;
+    virtual std::optional<CGPoint> cursor() = 0;
+    // False when the window server refused to move the cursor.
+    virtual bool warp_cursor(CGPoint point) = 0;
+    virtual void sleep_ms(int milliseconds) = 0;
+    // Monotonic time in milliseconds; the hover settle ends at a deadline on this clock.
+    virtual double now_ms() = 0;
+};
+
+std::shared_ptr<InputPlatform> system_input_platform();
+
+MAA_CTRL_UNIT_NS_END
diff --git a/source/MaaMacOSControlUnit/Input/InputPlatform.mm b/source/MaaMacOSControlUnit/Input/InputPlatform.mm
new file mode 100644
index 0000000..3e27a9e
--- /dev/null
+++ b/source/MaaMacOSControlUnit/Input/InputPlatform.mm
@@ -0,0 +1,203 @@
+#include "InputPlatform.h"
+
+#include "MaaUtils/Logger.h"
+
+#include <chrono>
+#include <unistd.h>
+
+MAA_CTRL_UNIT_NS_BEGIN
+
+namespace
+{
+
+constexpr float kAxTimeoutSeconds = 0.25f;
+
+AXUIElementRef system_wide()
+{
+    static AXUIElementRef element = [] {
+        AXUIElementRef created = AXUIElementCreateSystemWide();
+        AXUIElementSetMessagingTimeout(created, kAxTimeoutSeconds);
+        return created;
+    }();
+    return element;
+}
+
+class SystemInputPlatform : public InputPlatform
+{
+public:
+    std::optional<WindowState> window(uint32_t window_id) override { return query_window(window_id); }
+
+    // GetFrontProcess is deprecated but still answers from the window server without a run loop;
+    // NSWorkspace.frontmostApplication goes stale in a process that does not run its main loop, and
+    // the accessibility server's focused application fails for apps that do not answer accessibility
+    // requests (-25204 observed with Activity Monitor in front).
+    pid_t front_pid() override
+    {
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+        ProcessSerialNumber psn {};
+        pid_t pid = -1;
+        if (GetFrontProcess(&psn) != noErr || GetProcessPID(&psn, &pid) != noErr) {
+            pid = -1;
+        }
+#pragma clang diagnostic pop
+        return pid;
+    }
+
+    // The window server's hit test behind this skips click-through overlays, which the window list
+    // cannot tell apart (several apps keep full-screen transparent windows above everything).
+    pid_t process_at(CGPoint point, int* error) override
+    {
+        AXUIElementRef element = nullptr;
+        AXError result =
+            AXUIElementCopyElementAtPosition(system_wide(), static_cast<float>(point.x), static_cast<float>(point.y), &element);
+        *error = result;
+        if (result != kAXErrorSuccess || !element) {
+            return -1;
+        }
+        pid_t pid = -1;
+        if (AXUIElementGetPid(element, &pid) != kAXErrorSuccess) {
+            pid = -1;
+        }
+        CFRelease(element);
+        return pid;
+    }
+
+    uint32_t front_window_of_process_at(pid_t pid, CGPoint point) override
+    {
+        CFArrayRef list =
+            CGWindowListCopyWindowInfo(kCGWindowListOptionOnScreenOnly | kCGWindowListExcludeDesktopElements, kCGNullWindowID);
+        if (!list) {
+            return 0;
+        }
+        uint32_t found = 0;
+        for (CFIndex i = 0; i < CFArrayGetCount(list) && found == 0; ++i) {
+            auto info = static_cast<CFDictionaryRef>(CFArrayGetValueAtIndex(list, i));
+            pid_t owner = -1;
+            if (auto ref = static_cast<CFNumberRef>(CFDictionaryGetValue(info, kCGWindowOwnerPID))) {
+                CFNumberGetValue(ref, kCFNumberIntType, &owner);
+            }
+            if (owner != pid) {
+                continue;
+            }
+            double alpha = 1;
+            if (auto ref = static_cast<CFNumberRef>(CFDictionaryGetValue(info, kCGWindowAlpha))) {
+                CFNumberGetValue(ref, kCFNumberDoubleType, &alpha);
+            }
+            CGRect bounds = CGRectZero;
+            if (auto ref = static_cast<CFDictionaryRef>(CFDictionaryGetValue(info, kCGWindowBounds))) {
+                CGRectMakeWithDictionaryRepresentation(ref, &bounds);
+            }
+            if (alpha <= 0 || !CGRectContainsPoint(bounds, point)) {
+                continue;
+            }
+            if (auto ref = static_cast<CFNumberRef>(CFDictionaryGetValue(info, kCGWindowNumber))) {
+                CFNumberGetValue(ref, kCFNumberSInt32Type, &found);
+            }
+        }
+        CFRelease(list);
+        return found;
+    }
+
+    CGRect display_bounds(CGDirectDisplayID display_id) override { return CGDisplayBounds(display_id); }
+
+    DisplayMode display_mode(CGDirectDisplayID display_id) override { return MAA_CTRL_UNIT_NS::display_mode(display_id); }
+
+    bool post_mouse(CGEventType type, CGPoint location, CGMouseButton button) override
+    {
+        CGEventRef event = CGEventCreateMouseEvent(nullptr, type, location, button);
+        if (!event) {
+            LogError << "failed to create mouse event";
+            return false;
+        }
+        CGEventPost(kCGHIDEventTap, event);
+        CFRelease(event);
+        return true;
+    }
+
+    bool post_scroll(CGPoint location, int lines_y, int lines_x) override
+    {
+        CGEventRef event = CGEventCreateScrollWheelEvent(nullptr, kCGScrollEventUnitLine, 2, lines_y, lines_x);
+        if (!event) {
+            LogError << "failed to create scroll event";
+            return false;
+        }
+        CGEventSetLocation(event, location);
+        CGEventPost(kCGHIDEventTap, event);
+        CFRelease(event);
+        return true;
+    }
+
+    bool post_key(pid_t pid, CGKeyCode key, bool down) override
+    {
+        CGEventRef event = CGEventCreateKeyboardEvent(nullptr, key, down);
+        if (!event) {
+            LogError << "failed to create keyboard event";
+            return false;
+        }
+        CGEventPostToPid(pid, event);
+        CFRelease(event);
+        return true;
+    }
+
+    bool post_text(pid_t pid, const std::vector<UniChar>& chars) override
+    {
+        for (bool down : { true, false }) {
+            CGEventRef event = CGEventCreateKeyboardEvent(nullptr, 0, down);
+            if (!event) {
+                LogError << "failed to create keyboard event";
+                return false;
+            }
+            CGEventKeyboardSetUnicodeString(event, chars.size(), chars.data());
+            CGEventPostToPid(pid, event);
+            CFRelease(event);
+            usleep(10000);
+        }
+        return true;
+    }
+
+    // Posted to the process, the cursor stays where it is and the game turns the camera.
+    bool post_relative_move(pid_t pid, int dx, int dy) override
+    {
+        CGPoint location = cursor().value_or(CGPointZero);
+        CGEventRef event = CGEventCreateMouseEvent(nullptr, kCGEventMouseMoved, location, kCGMouseButtonLeft);
+        if (!event) {
+            LogError << "failed to create mouse-moved event";
+            return false;
+        }
+        CGEventSetIntegerValueField(event, kCGMouseEventDeltaX, dx);
+        CGEventSetIntegerValueField(event, kCGMouseEventDeltaY, dy);
+        CGEventPostToPid(pid, event);
+        CFRelease(event);
+        return true;
+    }
+
+    std::optional<CGPoint> cursor() override
+    {
+        CGEventRef current = CGEventCreate(nullptr);
+        if (!current) {
+            return std::nullopt;
+        }
+        CGPoint point = CGEventGetLocation(current);
+        CFRelease(current);
+        return point;
+    }
+
+    bool warp_cursor(CGPoint point) override { return CGWarpMouseCursorPosition(point) == kCGErrorSuccess; }
+
+    void sleep_ms(int milliseconds) override { usleep(static_cast<useconds_t>(milliseconds) * 1000); }
+
+    double now_ms() override
+    {
+        return std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now().time_since_epoch()).count();
+    }
+};
+
+} // namespace
+
+std::shared_ptr<InputPlatform> system_input_platform()
+{
+    return std::make_shared<SystemInputPlatform>();
+}
+
+MAA_CTRL_UNIT_NS_END
