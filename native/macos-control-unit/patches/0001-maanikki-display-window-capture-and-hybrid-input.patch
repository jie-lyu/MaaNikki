diff --git a/source/MaaMacOSControlUnit/Screencap/DisplayWindowScreencap.h b/source/MaaMacOSControlUnit/Screencap/DisplayWindowScreencap.h
new file mode 100644
index 0000000..8c9e621
--- /dev/null
+++ b/source/MaaMacOSControlUnit/Screencap/DisplayWindowScreencap.h
@@ -0,0 +1,49 @@
+#pragma once
+
+#include <memory>
+#include <mutex>
+
+#include "Base/CaptureGeometry.h"
+#include "Base/UnitBase.h"
+
+#include "Common/Conf.h"
+
+MAA_CTRL_UNIT_NS_BEGIN
+
+// Captures one window as composited on its display, cropped to the part of
+// the window that lies on that display, at the display's native pixels.
+//
+// The window-only ScreenCaptureKit filter requests the window's point size
+// and includes its title bar; for a window whose title bar is pushed above
+// the top of the screen it squeezes the frame. Filtering the display down to
+// this window and cropping with sourceRect gives exactly the visible window
+// content, without the Dock, the menu bar or other windows.
+//
+// The shareable-content lookup and the filter are cached. Each capture
+// compares the window bounds, the display bounds and the display mode with
+// the cached values through CGWindowList / CGDisplay (cheap) and rebuilds
+// only when one of them changed.
+class DisplayWindowScreencap : public ScreencapBase
+{
+public:
+    DisplayWindowScreencap(uint32_t window_id, std::shared_ptr<CaptureGeometry> geometry);
+    virtual ~DisplayWindowScreencap() override;
+
+public: // from ScreencapBase
+    virtual std::optional<cv::Mat> screencap() override;
+
+private:
+    struct Target;
+
+    bool target_still_valid(const WindowState& window) const;
+    bool rebuild_target(const WindowState& window);
+    void reset_target();
+
+    uint32_t window_id_ = 0;
+    std::shared_ptr<CaptureGeometry> geometry_;
+
+    std::mutex mutex_;
+    std::unique_ptr<Target> target_;
+};
+
+MAA_CTRL_UNIT_NS_END
diff --git a/source/MaaMacOSControlUnit/Screencap/DisplayWindowScreencap.mm b/source/MaaMacOSControlUnit/Screencap/DisplayWindowScreencap.mm
new file mode 100644
index 0000000..c17723a
--- /dev/null
+++ b/source/MaaMacOSControlUnit/Screencap/DisplayWindowScreencap.mm
@@ -0,0 +1,246 @@
+#include "DisplayWindowScreencap.h"
+
+#include "MaaUtils/Logger.h"
+#include <opencv2/core.hpp>
+#include <opencv2/imgproc.hpp>
+
+#include <CoreMedia/CoreMedia.h>
+#include <CoreVideo/CoreVideo.h>
+#include <ScreenCaptureKit/ScreenCaptureKit.h>
+
+#include <cmath>
+
+MAA_CTRL_UNIT_NS_BEGIN
+
+cv::Mat image_from_sample_buffer(CMSampleBufferRef sample_buffer); // ScreenCaptureKitScreencap.mm
+
+namespace
+{
+
+constexpr int64_t kTimeoutNs = 5 * NSEC_PER_SEC;
+
+bool same_rect(CGRect a, CGRect b)
+{
+    return CGRectEqualToRect(CGRectIntegral(a), CGRectIntegral(b));
+}
+
+} // namespace
+
+// Objective-C objects are retained here and released in reset_target() (the unit builds without ARC).
+struct DisplayWindowScreencap::Target
+{
+    SCContentFilter* filter = nil;
+    SCStreamConfiguration* config = nil;
+    CaptureFrame frame;
+    CGRect display_bounds = CGRectZero;
+    DisplayMode mode;
+};
+
+DisplayWindowScreencap::DisplayWindowScreencap(uint32_t window_id, std::shared_ptr<CaptureGeometry> geometry)
+    : window_id_(window_id)
+    , geometry_(std::move(geometry))
+{
+}
+
+DisplayWindowScreencap::~DisplayWindowScreencap()
+{
+    std::lock_guard lock(mutex_);
+    reset_target();
+}
+
+void DisplayWindowScreencap::reset_target()
+{
+    if (target_) {
+        [target_->filter release];
+        [target_->config release];
+        target_.reset();
+    }
+    if (geometry_) {
+        geometry_->invalidate();
+    }
+}
+
+bool DisplayWindowScreencap::target_still_valid(const WindowState& window) const
+{
+    if (!target_) {
+        return false;
+    }
+    const auto& cached = target_->frame;
+    return window.pid == cached.pid && same_rect(window.bounds, cached.window_bounds)
+           && same_rect(CGDisplayBounds(cached.display_id), target_->display_bounds) && display_mode(cached.display_id) == target_->mode;
+}
+
+// Fills lookup.window / lookup.display (retained) with the window and the display holding most of it.
+template <typename Lookup>
+static void pick_window_and_display(SCShareableContent* content, uint32_t window_id, Lookup& lookup)
+{
+    for (SCWindow* candidate in content.windows) {
+        if (candidate.windowID == window_id) {
+            lookup.window = [candidate retain];
+            break;
+        }
+    }
+    if (!lookup.window) {
+        return;
+    }
+    CGFloat best = 0;
+    for (SCDisplay* display in content.displays) {
+        CGRect overlap = CGRectIntersection(display.frame, lookup.window.frame);
+        CGFloat area = CGRectIsNull(overlap) ? 0 : overlap.size.width * overlap.size.height;
+        if (area > best) {
+            best = area;
+            [lookup.display release];
+            lookup.display = [display retain];
+        }
+    }
+}
+
+bool DisplayWindowScreencap::rebuild_target(const WindowState& window)
+{
+    reset_target();
+
+    // Shared by this call and the handler, so objects retained after a timeout are released when the
+    // late handler finishes. The handler must not touch `this`: the unit may be gone by then.
+    struct Lookup
+    {
+        SCWindow* window = nil;
+        SCDisplay* display = nil;
+
+        ~Lookup()
+        {
+            [window release];
+            [display release];
+        }
+    };
+    auto lookup = std::make_shared<Lookup>();
+    const uint32_t wanted_id = window_id_;
+    dispatch_semaphore_t semaphore = dispatch_semaphore_create(0);
+
+    [SCShareableContent getShareableContentExcludingDesktopWindows:YES
+                                               onScreenWindowsOnly:YES
+                                                 completionHandler:^(SCShareableContent* content, NSError* error) {
+                                                     if (!error && content) {
+                                                         pick_window_and_display(content, wanted_id, *lookup);
+                                                     }
+                                                     dispatch_semaphore_signal(semaphore);
+                                                 }];
+
+    bool signalled = dispatch_semaphore_wait(semaphore, dispatch_time(DISPATCH_TIME_NOW, kTimeoutNs)) == 0;
+    dispatch_release(semaphore);
+    if (!signalled) {
+        LogError << "shareable content lookup timed out" << VAR(window_id_);
+        return false;
+    }
+    SCWindow* found_window = lookup->window;
+    SCDisplay* found_display = lookup->display;
+    if (!found_window || !found_display) {
+        LogError << "window or its display not found in shareable content" << VAR(window_id_) << VAR(found_window != nil)
+                 << VAR(found_display != nil);
+        return false;
+    }
+
+    CGRect display_frame = found_display.frame;
+    CGRect visible = CGRectIntersection(found_window.frame, display_frame);
+    SCContentFilter* filter = [[SCContentFilter alloc] initWithDisplay:found_display includingWindows:@[ found_window ]];
+    double scale = 0;
+    if (@available(macOS 14.0, *)) {
+        scale = filter.pointPixelScale;
+    }
+
+    auto target = std::make_unique<Target>();
+    target->filter = filter;
+    target->config = [[SCStreamConfiguration alloc] init];
+    target->config.sourceRect = CGRectOffset(visible, -display_frame.origin.x, -display_frame.origin.y);
+    target->config.width = static_cast<size_t>(std::lround(visible.size.width * scale));
+    target->config.height = static_cast<size_t>(std::lround(visible.size.height * scale));
+    target->config.pixelFormat = kCVPixelFormatType_32BGRA;
+    target->config.colorSpaceName = kCGColorSpaceSRGB;
+    target->config.showsCursor = NO;
+
+    target->frame.window_id = window_id_;
+    target->frame.pid = window.pid;
+    target->frame.display_id = found_display.displayID;
+    target->frame.window_bounds = window.bounds;
+    target->frame.captured_rect = visible;
+    target->frame.scale = scale;
+    target->frame.width = static_cast<int>(target->config.width);
+    target->frame.height = static_cast<int>(target->config.height);
+    target->display_bounds = CGDisplayBounds(found_display.displayID);
+    target->mode = display_mode(found_display.displayID);
+    target->frame.display_bounds = target->display_bounds;
+    target->frame.display_pixel_width = target->mode.pixel_width;
+    target->frame.display_pixel_height = target->mode.pixel_height;
+
+    LogInfo << "capture target" << VAR(window_id_) << VAR(target->frame.display_id) << VAR(found_window.frame.origin.x)
+            << VAR(found_window.frame.origin.y) << VAR(found_window.frame.size.width) << VAR(found_window.frame.size.height)
+            << VAR(window.bounds.origin.x) << VAR(window.bounds.origin.y) << VAR(window.bounds.size.width) << VAR(window.bounds.size.height)
+            << VAR(visible.origin.x) << VAR(visible.origin.y) << VAR(visible.size.width) << VAR(visible.size.height) << VAR(scale)
+            << VAR(target->frame.width) << VAR(target->frame.height);
+
+    if (target->frame.width <= 0 || target->frame.height <= 0) {
+        LogError << "window has no visible area on its display" << VAR(window_id_);
+        [target->filter release];
+        [target->config release];
+        return false;
+    }
+
+    target_ = std::move(target);
+    return true;
+}
+
+std::optional<cv::Mat> DisplayWindowScreencap::screencap()
+{
+    std::lock_guard lock(mutex_);
+
+    auto window = query_window(window_id_);
+    if (!window || !window->on_screen) {
+        LogError << "target window is gone or off screen" << VAR(window_id_);
+        reset_target();
+        return std::nullopt;
+    }
+    if (!target_still_valid(*window) && !rebuild_target(*window)) {
+        return std::nullopt;
+    }
+    dispatch_semaphore_t semaphore = dispatch_semaphore_create(0);
+    __block cv::Mat captured;
+    __block bool ok = false;
+
+    if (@available(macOS 14.0, *)) {
+        [SCScreenshotManager captureSampleBufferWithFilter:target_->filter
+                                             configuration:target_->config
+                                         completionHandler:^(CMSampleBufferRef sample_buffer, NSError* error) {
+                                             if (!error && sample_buffer) {
+                                                 captured = image_from_sample_buffer(sample_buffer);
+                                                 ok = !captured.empty();
+                                             }
+                                             dispatch_semaphore_signal(semaphore);
+                                         }];
+    }
+
+    bool signalled = dispatch_semaphore_wait(semaphore, dispatch_time(DISPATCH_TIME_NOW, kTimeoutNs)) == 0;
+    dispatch_release(semaphore);
+    if (!signalled || !ok) {
+        LogError << "capture failed" << VAR(window_id_) << VAR(signalled);
+        reset_target();
+        return std::nullopt;
+    }
+    if (captured.cols != target_->frame.width || captured.rows != target_->frame.height) {
+        LogError << "capture size differs from the request" << VAR(captured.cols) << VAR(captured.rows) << VAR(target_->frame.width)
+                 << VAR(target_->frame.height);
+        reset_target();
+        return std::nullopt;
+    }
+
+    // The window may have moved while the frame was taken; publish only a frame whose geometry still holds.
+    auto after = query_window(window_id_);
+    if (!after || !target_still_valid(*after)) {
+        LogWarn << "window geometry changed during capture, dropping the frame" << VAR(window_id_);
+        reset_target();
+        return std::nullopt;
+    }
+
+    geometry_->publish(target_->frame);
+    return captured;
+}
+
+MAA_CTRL_UNIT_NS_END
diff --git a/test/maanikki/HybridInputTest.mm b/test/maanikki/HybridInputTest.mm
new file mode 100644
index 0000000..0995aa4
--- /dev/null
+++ b/test/maanikki/HybridInputTest.mm
@@ -0,0 +1,388 @@
+// Deterministic tests for HybridInput over a fake InputPlatform: orderings a real desktop cannot
+// reproduce on demand (a stop racing a press), and every refusal path. Nothing reaches the system.
+// Built only with -DMAANIKKI_UNIT_TESTS=ON; never part of the shipped unit.
+
+#include "Base/CaptureGeometry.h"
+#include "Input/HybridInput.h"
+#include "Input/InputPlatform.h"
+
+#include <condition_variable>
+#include <cstdio>
+#include <functional>
+#include <future>
+#include <string>
+#include <thread>
+#include <vector>
+
+using namespace MAA_CTRL_UNIT_NS;
+
+namespace
+{
+
+constexpr uint32_t kWindow = 42;
+constexpr pid_t kGame = 100;
+int failures = 0;
+
+#define CHECK(condition)                                                              \
+    do {                                                                              \
+        if (!(condition)) {                                                           \
+            std::fprintf(stderr, "%s:%d: CHECK failed: %s\n", __FILE__, __LINE__, #condition); \
+            ++failures;                                                               \
+        }                                                                             \
+    } while (false)
+
+struct FakePlatform : InputPlatform
+{
+    std::mutex mutex;
+    WindowState win { kGame, CGRectMake(0, 0, 1920, 1080), true };
+    pid_t front = kGame;
+    pid_t hit_pid = kGame;
+    uint32_t hit_window = kWindow;
+    std::function<void()> on_hit_test;
+    std::vector<std::string> events;
+    bool reject_ups = false; // post_mouse/post_key fail for releases
+
+    // When set, the next mouse-down blocks inside post_mouse until `release_down` is fulfilled.
+    bool block_down = false;
+    std::promise<void> down_entered;
+    std::shared_future<void> release_down;
+
+    std::optional<WindowState> window(uint32_t id) override
+    {
+        std::lock_guard lock(mutex);
+        return id == kWindow ? std::optional(win) : std::nullopt;
+    }
+
+    pid_t front_pid() override
+    {
+        std::lock_guard lock(mutex);
+        return front;
+    }
+
+    pid_t process_at(CGPoint, int* error) override
+    {
+        if (on_hit_test) {
+            on_hit_test();
+        }
+        *error = 0;
+        std::lock_guard lock(mutex);
+        return hit_pid;
+    }
+
+    uint32_t front_window_of_process_at(pid_t, CGPoint) override
+    {
+        std::lock_guard lock(mutex);
+        return hit_window;
+    }
+
+    CGRect display_bounds(CGDirectDisplayID) override { return CGRectMake(0, 0, 1920, 1080); }
+
+    DisplayMode display_mode(CGDirectDisplayID) override { return { 3840, 2160 }; }
+
+    bool post_mouse(CGEventType type, CGPoint location, CGMouseButton) override
+    {
+        bool is_down = type == kCGEventLeftMouseDown;
+        if (type == kCGEventLeftMouseUp && reject_ups) {
+            return false;
+        }
+        if (is_down && block_down) {
+            block_down = false;
+            down_entered.set_value();
+            release_down.wait();
+        }
+        record((is_down ? "down@" : type == kCGEventLeftMouseUp ? "up@" : "drag@") + std::to_string(int(location.x)) + ","
+               + std::to_string(int(location.y)));
+        return true;
+    }
+
+    bool post_key(pid_t pid, CGKeyCode key, bool down) override
+    {
+        if (!down && reject_ups) {
+            return false;
+        }
+        record(std::string(down ? "key_down " : "key_up ") + std::to_string(key) + " pid=" + std::to_string(pid));
+        return true;
+    }
+
+    bool post_text(pid_t, const std::vector<UniChar>&) override
+    {
+        record("text");
+        return true;
+    }
+
+    bool post_relative_move(pid_t, int dx, int dy) override
+    {
+        record("move " + std::to_string(dx) + "," + std::to_string(dy));
+        return true;
+    }
+
+    std::optional<CGPoint> cursor() override { return CGPointMake(7, 7); }
+
+    void warp_cursor(CGPoint point) override { record("warp@" + std::to_string(int(point.x)) + "," + std::to_string(int(point.y))); }
+
+    void record(std::string event)
+    {
+        std::lock_guard lock(mutex);
+        events.push_back(std::move(event));
+    }
+
+    std::vector<std::string> take()
+    {
+        std::lock_guard lock(mutex);
+        return std::exchange(events, {});
+    }
+};
+
+CaptureFrame frame(CGRect window_bounds = CGRectMake(0, 0, 1920, 1080))
+{
+    CaptureFrame f;
+    f.window_id = kWindow;
+    f.pid = kGame;
+    f.display_id = 1;
+    f.window_bounds = window_bounds;
+    f.captured_rect = window_bounds;
+    f.scale = 2;
+    f.width = int(window_bounds.size.width * 2);
+    f.height = int(window_bounds.size.height * 2);
+    f.display_bounds = CGRectMake(0, 0, 1920, 1080);
+    f.display_pixel_width = 3840;
+    f.display_pixel_height = 2160;
+    return f;
+}
+
+struct Fixture
+{
+    std::shared_ptr<FakePlatform> platform = std::make_shared<FakePlatform>();
+    std::shared_ptr<CaptureGeometry> geometry = std::make_shared<CaptureGeometry>();
+    std::unique_ptr<HybridInput> input;
+
+    Fixture()
+    {
+        geometry->publish(frame());
+        input = std::make_unique<HybridInput>(kWindow, geometry, platform);
+    }
+};
+
+using Events = std::vector<std::string>;
+
+void accepted_click_maps_once_and_restores_cursor()
+{
+    Fixture t;
+    CHECK(t.input->touch_down(0, 100, 200, 0));
+    CHECK(t.input->touch_up(0));
+    CHECK((t.platform->take() == Events { "down@50,100", "up@50,100", "warp@7,7" }));
+}
+
+void refused_press_sends_no_release_or_drag()
+{
+    Fixture t;
+    t.platform->front = 999;
+    CHECK(!t.input->touch_down(0, 100, 200, 0));
+    CHECK(!t.input->touch_move(0, 110, 200, 0));
+    CHECK(t.input->touch_up(0));
+    t.platform->front = kGame;
+    CHECK(t.platform->take().empty());
+    // The worker's own release after a refusal does not cancel the next press.
+    CHECK(t.input->touch_down(0, 100, 200, 0));
+    CHECK(t.input->touch_up(0));
+    CHECK(t.platform->take().size() == 3);
+}
+
+void stop_before_press_cancels_it_however_late()
+{
+    Fixture t;
+    // The core recorded the press, then its stopping thread released it before the unit saw it.
+    std::thread([&] { t.input->touch_up(0); t.input->key_up(13); }).join();
+    std::this_thread::sleep_for(std::chrono::milliseconds(700)); // longer than any timeout would allow
+    CHECK(!t.input->touch_down(0, 100, 200, 0));
+    CHECK(!t.input->key_down(13));
+    CHECK(t.platform->take().empty());
+    // The cancellation was consumed; the next press goes through.
+    CHECK(t.input->key_down(13));
+    CHECK(t.input->key_up(13));
+    CHECK(t.platform->take().size() == 2);
+}
+
+void inactive_clears_unconsumed_cancellations()
+{
+    Fixture t;
+    std::thread([&] { t.input->touch_up(0); }).join();
+    t.input->inactive();
+    CHECK(t.input->touch_down(0, 100, 200, 0));
+    t.input->inactive();
+    CHECK((t.platform->take() == Events { "down@50,100", "up@50,100", "warp@7,7" }));
+}
+
+void stop_during_press_releases_after_it()
+{
+    Fixture t;
+    std::promise<void> release;
+    t.platform->block_down = true;
+    t.platform->release_down = release.get_future().share();
+    auto entered = t.platform->down_entered.get_future();
+
+    std::thread worker([&] { CHECK(t.input->touch_down(0, 100, 200, 0)); });
+    entered.wait(); // the worker is inside the press, holding the input lock
+    std::atomic<bool> stop_returned = false;
+    std::thread stopper([&] {
+        t.input->touch_up(0);
+        stop_returned = true;
+    });
+    std::this_thread::sleep_for(std::chrono::milliseconds(100));
+    CHECK(!stop_returned); // the release waits for the press to finish
+    release.set_value();
+    worker.join();
+    stopper.join();
+    CHECK((t.platform->take() == Events { "down@50,100", "up@50,100", "warp@7,7" }));
+}
+
+void key_release_goes_to_the_pressing_process()
+{
+    Fixture t;
+    CHECK(t.input->key_down(13));
+    t.platform->win.pid = 300; // window id reused by another process
+    CHECK(t.input->key_up(13));
+    CHECK((t.platform->take() == Events { "key_down 13 pid=100", "key_up 13 pid=100" }));
+}
+
+void foreground_is_required_for_keys_text_and_moves()
+{
+    Fixture t;
+    t.platform->front = 999;
+    CHECK(!t.input->key_down(13));
+    CHECK(!t.input->input_text("a"));
+    CHECK(!t.input->relative_move(10, 0));
+    t.platform->win.on_screen = false;
+    t.platform->front = kGame;
+    CHECK(!t.input->key_down(13));
+    CHECK(t.platform->take().empty());
+}
+
+void click_needs_hit_test_evidence()
+{
+    Fixture t;
+    t.platform->hit_pid = 555; // Dock, menu bar or another app receives the click there
+    CHECK(!t.input->touch_down(0, 100, 200, 0));
+    t.platform->hit_pid = kGame;
+    t.platform->hit_window = 43; // another window of the game covers the point
+    CHECK(!t.input->touch_down(0, 100, 200, 0));
+    t.platform->hit_window = kWindow;
+    t.platform->on_hit_test = [&] { t.platform->front = 999; }; // user switches apps during the hit test
+    CHECK(!t.input->touch_down(0, 100, 200, 0));
+    CHECK(t.platform->take().empty());
+}
+
+void click_outside_frame_or_moved_window_is_refused()
+{
+    Fixture t;
+    CHECK(!t.input->touch_down(0, 3840, 10, 0));
+    t.platform->win.bounds = CGRectMake(10, 0, 1920, 1080);
+    CHECK(!t.input->touch_down(0, 100, 200, 0));
+    CHECK(t.platform->take().empty());
+}
+
+void geometry_change_latches_until_reconnect()
+{
+    Fixture t;
+    CGRect moved = CGRectMake(0, 0, 1600, 900);
+    t.platform->win.bounds = moved;
+    t.geometry->publish(frame(moved));
+    t.geometry->publish(frame(moved));
+    CHECK(!t.input->touch_down(0, 100, 200, 0)); // still refused after more frames at the new geometry
+    CHECK(t.geometry->changed());
+    t.geometry->reset();                         // reconnect
+    t.geometry->publish(frame(moved));
+    CHECK(!t.geometry->changed());
+    CHECK(t.input->touch_down(0, 100, 200, 0));
+    CHECK(t.input->touch_up(0));
+    CHECK(t.platform->take().size() == 3);
+}
+
+void inactive_and_destruction_release_everything()
+{
+    Fixture t;
+    CHECK(t.input->key_down(13));
+    CHECK(t.input->touch_down(0, 100, 200, 0));
+    CHECK(t.input->inactive());
+    CHECK((t.platform->take() == Events { "key_down 13 pid=100", "down@50,100", "up@50,100", "warp@7,7", "key_up 13 pid=100" }));
+    CHECK(t.input->key_down(1));
+    t.input.reset();
+    CHECK((t.platform->take() == Events { "key_down 1 pid=100", "key_up 1 pid=100" }));
+}
+
+void failed_release_stays_held_and_is_reported()
+{
+    Fixture t;
+    CHECK(t.input->key_down(13));
+    CHECK(t.input->touch_down(0, 100, 200, 0));
+    t.platform->take();
+    t.platform->reject_ups = true;
+    CHECK(!t.input->inactive()); // the core and the agent learn that something is still down
+    CHECK(!t.input->touch_up(0));
+    CHECK(t.platform->take().empty());
+    t.platform->reject_ups = false;
+    CHECK(t.input->inactive()); // retried and released
+    CHECK((t.platform->take() == Events { "up@50,100", "warp@7,7", "key_up 13 pid=100" }));
+}
+
+void press_of_a_still_held_key_is_posted_again()
+{
+    Fixture t;
+    CHECK(t.input->key_down(13));
+    // The agent released W straight to the game; the unit still counts it as down.
+    CHECK(t.input->key_down(13));
+    CHECK((t.platform->take() == Events { "key_down 13 pid=100", "key_down 13 pid=100" }));
+    t.platform->front = 999;
+    CHECK(!t.input->key_down(13)); // still foreground-only
+}
+
+void stop_release_of_an_old_hold_still_cancels_the_pending_press()
+{
+    Fixture t;
+    CHECK(t.input->key_down(13));
+    CHECK(t.input->touch_down(0, 100, 200, 0));
+    t.platform->take();
+    // The core registered another press, then its stopping thread released before the unit saw it;
+    // that release matches the older hold.
+    std::thread([&] { t.input->key_up(13); t.input->touch_up(0); }).join();
+    CHECK((t.platform->take() == Events { "key_up 13 pid=100", "up@50,100", "warp@7,7" }));
+    CHECK(!t.input->key_down(13));
+    CHECK(!t.input->touch_down(0, 100, 200, 0));
+    CHECK(t.platform->take().empty());
+    t.input->inactive(); // the task ended; the next press is ordinary again
+    CHECK(t.input->key_down(13));
+}
+
+void repeat_for_another_process_is_refused_and_the_owner_kept()
+{
+    Fixture t;
+    CHECK(t.input->key_down(13));
+    t.platform->win.pid = 300; // window id reused by another process, now in front
+    t.platform->front = 300;
+    CHECK(!t.input->key_down(13));
+    CHECK(t.input->key_up(13));
+    CHECK((t.platform->take() == Events { "key_down 13 pid=100", "key_up 13 pid=100" }));
+}
+
+} // namespace
+
+int main()
+{
+    accepted_click_maps_once_and_restores_cursor();
+    refused_press_sends_no_release_or_drag();
+    stop_before_press_cancels_it_however_late();
+    inactive_clears_unconsumed_cancellations();
+    stop_during_press_releases_after_it();
+    key_release_goes_to_the_pressing_process();
+    foreground_is_required_for_keys_text_and_moves();
+    click_needs_hit_test_evidence();
+    click_outside_frame_or_moved_window_is_refused();
+    geometry_change_latches_until_reconnect();
+    inactive_and_destruction_release_everything();
+    failed_release_stays_held_and_is_reported();
+    press_of_a_still_held_key_is_posted_again();
+    stop_release_of_an_old_hold_still_cancels_the_pending_press();
+    repeat_for_another_process_is_refused_and_the_owner_kept();
+    std::printf(failures ? "HybridInputTest: %d failure(s)\n" : "HybridInputTest: all passed\n", failures);
+    return failures ? 1 : 0;
+}
