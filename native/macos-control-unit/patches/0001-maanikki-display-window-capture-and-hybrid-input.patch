+CaptureFrame frame(CGRect window_bounds = CGRectMake(0, 0, 1920, 1080))
+{
+    CaptureFrame f;
+    f.window_id = kWindow;
+    f.pid = kGame;
+    f.display_id = 1;
+    f.window_bounds = window_bounds;
+    f.captured_rect = window_bounds;
+    f.scale = 2;
+    f.width = int(window_bounds.size.width * 2);
+    f.height = int(window_bounds.size.height * 2);
+    f.display_bounds = CGRectMake(0, 0, 1920, 1080);
+    f.display_pixel_width = 3840;
+    f.display_pixel_height = 2160;
+    return f;
+}
