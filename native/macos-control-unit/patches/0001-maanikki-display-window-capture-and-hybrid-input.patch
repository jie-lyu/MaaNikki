diff --git a/source/MaaMacOSControlUnit/Base/CaptureGeometry.cpp b/source/MaaMacOSControlUnit/Base/CaptureGeometry.cpp
new file mode 100644
index 0000000..6579457
--- /dev/null
+++ b/source/MaaMacOSControlUnit/Base/CaptureGeometry.cpp
@@ -0,0 +1,49 @@
+#include "CaptureGeometry.h"
+
+MAA_CTRL_UNIT_NS_BEGIN
+
+std::optional<WindowState> query_window(uint32_t window_id)
+{
+    if (window_id == 0) {
+        return std::nullopt;
+    }
+
+    CFArrayRef list = CGWindowListCopyWindowInfo(kCGWindowListOptionIncludingWindow, window_id);
+    if (!list) {
+        return std::nullopt;
+    }
+
+    std::optional<WindowState> result;
+    if (CFArrayGetCount(list) > 0) {
+        auto info = static_cast<CFDictionaryRef>(CFArrayGetValueAtIndex(list, 0));
+        WindowState state;
+
+        auto number = static_cast<CFNumberRef>(CFDictionaryGetValue(info, kCGWindowNumber));
+        uint32_t found_id = 0;
+        if (number) {
+            CFNumberGetValue(number, kCFNumberSInt32Type, &found_id);
+        }
+
+        auto pid = static_cast<CFNumberRef>(CFDictionaryGetValue(info, kCGWindowOwnerPID));
+        if (pid) {
+            CFNumberGetValue(pid, kCFNumberIntType, &state.pid);
+        }
+
+        auto bounds = static_cast<CFDictionaryRef>(CFDictionaryGetValue(info, kCGWindowBounds));
+        if (bounds) {
+            CGRectMakeWithDictionaryRepresentation(bounds, &state.bounds);
+        }
+
+        auto on_screen = static_cast<CFBooleanRef>(CFDictionaryGetValue(info, kCGWindowIsOnscreen));
+        state.on_screen = on_screen && CFBooleanGetValue(on_screen);
+
+        if (found_id == window_id && state.pid > 0) {
+            result = state;
+        }
+    }
+
+    CFRelease(list);
+    return result;
+}
+
+MAA_CTRL_UNIT_NS_END
diff --git a/source/MaaMacOSControlUnit/Base/CaptureGeometry.h b/source/MaaMacOSControlUnit/Base/CaptureGeometry.h
new file mode 100644
index 0000000..e886438
--- /dev/null
+++ b/source/MaaMacOSControlUnit/Base/CaptureGeometry.h
@@ -0,0 +1,64 @@
+#pragma once
+
+#include <mutex>
+#include <optional>
+
+#include <ApplicationServices/ApplicationServices.h>
+
+#include "Common/Conf.h"
+
+MAA_CTRL_UNIT_NS_BEGIN
+
+// Where the last captured frame sits on the desktop. Written by the
+// display-window screencap after every frame and read by the hybrid input,
+// so a click maps back through the same origin and scale as the frame it was
+// computed from, and each offset is applied exactly once.
+struct CaptureFrame
+{
+    uint32_t window_id = 0;
+    pid_t pid = -1;
+    CGDirectDisplayID display_id = 0;
+    CGRect window_bounds = CGRectZero; // CGWindowList bounds at capture time, global points
+    CGRect captured_rect = CGRectZero; // captured area, global points (top-left origin)
+    double scale = 0;                  // frame pixels per point
+    int width = 0;                     // frame size in pixels
+    int height = 0;
+};
+
+class CaptureGeometry
+{
+public:
+    void publish(const CaptureFrame& frame)
+    {
+        std::lock_guard lock(mutex_);
+        frame_ = frame;
+    }
+
+    void invalidate()
+    {
+        std::lock_guard lock(mutex_);
+        frame_.reset();
+    }
+
+    std::optional<CaptureFrame> latest() const
+    {
+        std::lock_guard lock(mutex_);
+        return frame_;
+    }
+
+private:
+    mutable std::mutex mutex_;
+    std::optional<CaptureFrame> frame_;
+};
+
+// CGWindowList view of one window: owner pid, global bounds in points, on-screen flag.
+struct WindowState
+{
+    pid_t pid = -1;
+    CGRect bounds = CGRectZero;
+    bool on_screen = false;
+};
+
+std::optional<WindowState> query_window(uint32_t window_id);
+
+MAA_CTRL_UNIT_NS_END
diff --git a/source/MaaMacOSControlUnit/Input/HybridInput.h b/source/MaaMacOSControlUnit/Input/HybridInput.h
new file mode 100644
index 0000000..60d7d94
--- /dev/null
+++ b/source/MaaMacOSControlUnit/Input/HybridInput.h
@@ -0,0 +1,71 @@
+#pragma once
+
+#include <memory>
+#include <set>
+
+#include "Base/CaptureGeometry.h"
+#include "Base/UnitBase.h"
+#include "Common/Conf.h"
+
+#include <ApplicationServices/ApplicationServices.h>
+
+MAA_CTRL_UNIT_NS_BEGIN
+
+// Input profile selected by MaaMacOSInputMethod_GlobalEvent | MaaMacOSInputMethod_PostToPid,
+// each event kind on the path that a game accepts:
+//
+// - keys and text are posted to the window's process (works in the foreground and the background);
+// - absolute mouse events go through the global HID stream (games ignore posted clicks), at the
+//   desktop point that the last captured frame maps the pixel to, and never activate the window;
+// - relative mouse movement is a mouse-moved event with delta fields posted to the process.
+//
+// Clicks need a frame from DisplayWindowScreencap: before each press the window must still exist
+// with the geometry of that frame, its process must own the frontmost window and the point must lie
+// inside the frame. Otherwise nothing is sent. Releases are always sent. Held keys and buttons are
+// released by inactive() and on destruction.
+class HybridInput : public InputBase
+{
+public:
+    HybridInput(uint32_t window_id, std::shared_ptr<CaptureGeometry> geometry);
+    virtual ~HybridInput() override;
+
+public: // from InputBase
+    virtual MaaControllerFeature get_features() const override;
+
+    virtual bool click(int x, int y) override;
+    virtual bool swipe(int x1, int y1, int x2, int y2, int duration) override;
+
+    virtual bool touch_down(int contact, int x, int y, int pressure) override;
+    virtual bool touch_move(int contact, int x, int y, int pressure) override;
+    virtual bool touch_up(int contact) override;
+
+    virtual bool click_key(int key) override;
+    virtual bool input_text(const std::string& text) override;
+
+    virtual bool key_down(int key) override;
+    virtual bool key_up(int key) override;
+
+    virtual bool scroll(int dx, int dy) override;
+
+    bool relative_move(int dx, int dy);
+    void release_all();
+
+private:
+    std::optional<CGPoint> checked_point(int x, int y, const char* action);
+    std::optional<pid_t> foreground_pid(const char* action);
+    std::optional<pid_t> target_pid(const char* action);
+
+    bool post_mouse(CGEventType type, CGPoint location, CGMouseButton button);
+    bool post_key(pid_t pid, CGKeyCode key, bool down);
+
+    uint32_t window_id_ = 0;
+    std::shared_ptr<CaptureGeometry> geometry_;
+
+    pid_t last_pid_ = -1;
+    std::set<int> held_keys_;
+    std::set<int> held_contacts_;
+    CGPoint last_point_ = CGPointZero;
+    CGPoint saved_cursor_ = { NAN, NAN };
+};
+
+MAA_CTRL_UNIT_NS_END
diff --git a/source/MaaMacOSControlUnit/Input/HybridInput.mm b/source/MaaMacOSControlUnit/Input/HybridInput.mm
new file mode 100644
index 0000000..2837a81
--- /dev/null
+++ b/source/MaaMacOSControlUnit/Input/HybridInput.mm
@@ -0,0 +1,370 @@
+#include "HybridInput.h"
+
+#include "InputUtils.h"
+#include "MaaUtils/Logger.h"
+
+#include <cmath>
+#include <tuple>
+#include <unistd.h>
+#include <vector>
+
+MAA_CTRL_UNIT_NS_BEGIN
+
+namespace
+{
+
+pid_t frontmost_window_pid()
+{
+    // The owner of the first on-screen normal-layer window is the active application. NSWorkspace
+    // would need a running main run loop in this process to stay current.
+    CFArrayRef list = CGWindowListCopyWindowInfo(kCGWindowListOptionOnScreenOnly | kCGWindowListExcludeDesktopElements, kCGNullWindowID);
+    if (!list) {
+        return -1;
+    }
+    pid_t pid = -1;
+    for (CFIndex i = 0; i < CFArrayGetCount(list); ++i) {
+        auto info = static_cast<CFDictionaryRef>(CFArrayGetValueAtIndex(list, i));
+        int layer = -1;
+        auto layer_ref = static_cast<CFNumberRef>(CFDictionaryGetValue(info, kCGWindowLayer));
+        if (layer_ref) {
+            CFNumberGetValue(layer_ref, kCFNumberIntType, &layer);
+        }
+        if (layer != 0) {
+            continue;
+        }
+        auto pid_ref = static_cast<CFNumberRef>(CFDictionaryGetValue(info, kCGWindowOwnerPID));
+        if (pid_ref) {
+            CFNumberGetValue(pid_ref, kCFNumberIntType, &pid);
+        }
+        break;
+    }
+    CFRelease(list);
+    return pid;
+}
+
+// Windows of other processes stacked above the target that contain the point. Logged for now:
+// which of them actually intercept clicks (Dock, menu bar, click-through overlays) is measured on
+// the real game before it becomes a rule.
+void log_windows_above(uint32_t window_id, pid_t pid, CGPoint point)
+{
+    CFArrayRef list = CGWindowListCopyWindowInfo(kCGWindowListOptionOnScreenAboveWindow, window_id);
+    if (!list) {
+        return;
+    }
+    for (CFIndex i = 0; i < CFArrayGetCount(list); ++i) {
+        auto info = static_cast<CFDictionaryRef>(CFArrayGetValueAtIndex(list, i));
+        pid_t owner = -1;
+        int layer = 0;
+        double alpha = 1;
+        CGRect bounds = CGRectZero;
+        if (auto ref = static_cast<CFNumberRef>(CFDictionaryGetValue(info, kCGWindowOwnerPID))) {
+            CFNumberGetValue(ref, kCFNumberIntType, &owner);
+        }
+        if (auto ref = static_cast<CFNumberRef>(CFDictionaryGetValue(info, kCGWindowLayer))) {
+            CFNumberGetValue(ref, kCFNumberIntType, &layer);
+        }
+        if (auto ref = static_cast<CFNumberRef>(CFDictionaryGetValue(info, kCGWindowAlpha))) {
+            CFNumberGetValue(ref, kCFNumberDoubleType, &alpha);
+        }
+        if (auto ref = static_cast<CFDictionaryRef>(CFDictionaryGetValue(info, kCGWindowBounds))) {
+            CGRectMakeWithDictionaryRepresentation(ref, &bounds);
+        }
+        if (owner == pid || !CGRectContainsPoint(bounds, point)) {
+            continue;
+        }
+        std::string owner_name;
+        if (auto ref = static_cast<CFStringRef>(CFDictionaryGetValue(info, kCGWindowOwnerName))) {
+            char buffer[256] = {};
+            if (CFStringGetCString(ref, buffer, sizeof(buffer), kCFStringEncodingUTF8)) {
+                owner_name = buffer;
+            }
+        }
+        LogInfo << "window above target at click point" << VAR(owner) << VAR(owner_name) << VAR(layer) << VAR(alpha) << VAR(bounds.origin.x)
+                << VAR(bounds.origin.y) << VAR(bounds.size.width) << VAR(bounds.size.height);
+    }
+    CFRelease(list);
+}
+
+} // namespace
+
+HybridInput::HybridInput(uint32_t window_id, std::shared_ptr<CaptureGeometry> geometry)
+    : window_id_(window_id)
+    , geometry_(std::move(geometry))
+{
+    if (auto window = query_window(window_id_)) {
+        last_pid_ = window->pid;
+    }
+}
+
+HybridInput::~HybridInput()
+{
+    release_all();
+}
+
+MaaControllerFeature HybridInput::get_features() const
+{
+    return MaaControllerFeature_UseMouseDownAndUpInsteadOfClick | MaaControllerFeature_UseKeyboardDownAndUpInsteadOfClick;
+}
+
+std::optional<pid_t> HybridInput::target_pid(const char* action)
+{
+    auto window = query_window(window_id_);
+    if (!window) {
+        LogError << "target window is gone, not sending" << VAR(action) << VAR(window_id_);
+        return std::nullopt;
+    }
+    last_pid_ = window->pid;
+    return window->pid;
+}
+
+std::optional<pid_t> HybridInput::foreground_pid(const char* action)
+{
+    auto pid = target_pid(action);
+    if (!pid) {
+        return std::nullopt;
+    }
+    pid_t front = frontmost_window_pid();
+    if (front != *pid) {
+        LogError << "target is not the frontmost application, not sending" << VAR(action) << VAR(*pid) << VAR(front);
+        return std::nullopt;
+    }
+    return pid;
+}
+
+std::optional<CGPoint> HybridInput::checked_point(int x, int y, const char* action)
+{
+    auto frame = geometry_->latest();
+    if (!frame || frame->window_id != window_id_ || frame->scale <= 0) {
+        LogError << "no captured frame to map the point through, not sending" << VAR(action);
+        return std::nullopt;
+    }
+    if (x < 0 || y < 0 || x >= frame->width || y >= frame->height) {
+        LogError << "point outside the captured frame, not sending" << VAR(action) << VAR(x) << VAR(y) << VAR(frame->width)
+                 << VAR(frame->height);
+        return std::nullopt;
+    }
+    auto window = query_window(window_id_);
+    if (!window || !window->on_screen || window->pid != frame->pid
+        || !CGRectEqualToRect(CGRectIntegral(window->bounds), CGRectIntegral(frame->window_bounds))) {
+        LogError << "window changed since the last frame, not sending" << VAR(action) << VAR(window.has_value());
+        return std::nullopt;
+    }
+    if (!foreground_pid(action)) {
+        return std::nullopt;
+    }
+    // Frame pixel -> global point: one origin, one scale, the same ones the frame was cropped with.
+    CGPoint point = CGPointMake(frame->captured_rect.origin.x + x / frame->scale, frame->captured_rect.origin.y + y / frame->scale);
+    log_windows_above(window_id_, frame->pid, point);
+    return point;
+}
+
+bool HybridInput::post_mouse(CGEventType type, CGPoint location, CGMouseButton button)
+{
+    CGEventRef event = CGEventCreateMouseEvent(nullptr, type, location, button);
+    if (!event) {
+        LogError << "failed to create mouse event";
+        return false;
+    }
+    CGEventPost(kCGHIDEventTap, event);
+    CFRelease(event);
+    return true;
+}
+
+bool HybridInput::post_key(pid_t pid, CGKeyCode key, bool down)
+{
+    CGEventRef event = CGEventCreateKeyboardEvent(nullptr, key, down);
+    if (!event) {
+        LogError << "failed to create keyboard event";
+        return false;
+    }
+    CGEventPostToPid(pid, event);
+    CFRelease(event);
+    return true;
+}
+
+bool HybridInput::click(int x, int y)
+{
+    LogError << "use touch_down/touch_up (UseMouseDownAndUpInsteadOfClick)" << VAR(x) << VAR(y);
+    return false;
+}
+
+bool HybridInput::swipe(int x1, int y1, int x2, int y2, int duration)
+{
+    LogError << "use touch_down/touch_move/touch_up (UseMouseDownAndUpInsteadOfClick)" << VAR(x1) << VAR(y1) << VAR(x2) << VAR(y2)
+             << VAR(duration);
+    return false;
+}
+
+bool HybridInput::touch_down(int contact, int x, int y, int pressure)
+{
+    std::ignore = pressure;
+
+    MouseEventInfo info;
+    if (!contact_to_mouse_down_info(contact, info)) {
+        LogError << "contact out of range" << VAR(contact);
+        return false;
+    }
+    auto point = checked_point(x, y, "touch_down");
+    if (!point) {
+        return false;
+    }
+
+    if (held_contacts_.empty()) {
+        CGEventRef current = CGEventCreate(nullptr);
+        if (current) {
+            saved_cursor_ = CGEventGetLocation(current);
+            CFRelease(current);
+        }
+    }
+    if (!post_mouse(info.event_type, *point, info.mouse_button)) {
+        return false;
+    }
+    held_contacts_.insert(contact);
+    last_point_ = *point;
+    return true;
+}
+
+bool HybridInput::touch_move(int contact, int x, int y, int pressure)
+{
+    std::ignore = pressure;
+
+    MouseEventInfo info;
+    if (!contact_to_mouse_move_info(contact, info)) {
+        LogError << "contact out of range" << VAR(contact);
+        return false;
+    }
+    auto point = checked_point(x, y, "touch_move");
+    if (!point) {
+        return false;
+    }
+    if (!post_mouse(info.event_type, *point, info.mouse_button)) {
+        return false;
+    }
+    last_point_ = *point;
+    return true;
+}
+
+bool HybridInput::touch_up(int contact)
+{
+    MouseEventInfo info;
+    if (!contact_to_mouse_up_info(contact, info)) {
+        LogError << "contact out of range" << VAR(contact);
+        return false;
+    }
+    // Released where it was pressed, whatever the window or the user's cursor did since.
+    bool ok = post_mouse(info.event_type, last_point_, info.mouse_button);
+    held_contacts_.erase(contact);
+    if (held_contacts_.empty() && !std::isnan(saved_cursor_.x)) {
+        CGWarpMouseCursorPosition(saved_cursor_);
+        saved_cursor_ = { NAN, NAN };
+    }
+    return ok;
+}
+
+bool HybridInput::click_key(int key)
+{
+    LogError << "use key_down/key_up (UseKeyboardDownAndUpInsteadOfClick)" << VAR(key);
+    return false;
+}
+
+bool HybridInput::input_text(const std::string& text)
+{
+    auto pid = target_pid("input_text");
+    if (!pid) {
+        return false;
+    }
+    std::vector<UniChar> chars;
+    if (!text_to_unichars(text, chars)) {
+        LogError << "failed to convert text" << VAR(text);
+        return false;
+    }
+    for (bool down : { true, false }) {
+        CGEventRef event = CGEventCreateKeyboardEvent(nullptr, 0, down);
+        if (!event) {
+            LogError << "failed to create keyboard event";
+            return false;
+        }
+        CGEventKeyboardSetUnicodeString(event, chars.size(), chars.data());
+        CGEventPostToPid(*pid, event);
+        CFRelease(event);
+        usleep(10000);
+    }
+    return true;
+}
+
+bool HybridInput::key_down(int key)
+{
+    if (key < 0 || key > 0xFFFF) {
+        LogError << "key code out of range" << VAR(key);
+        return false;
+    }
+    auto pid = target_pid("key_down");
+    if (!pid || !post_key(*pid, static_cast<CGKeyCode>(key), true)) {
+        return false;
+    }
+    held_keys_.insert(key);
+    return true;
+}
+
+bool HybridInput::key_up(int key)
+{
+    if (key < 0 || key > 0xFFFF) {
+        LogError << "key code out of range" << VAR(key);
+        return false;
+    }
+    held_keys_.erase(key);
+    // A release goes to the last known process even if the window has just closed.
+    pid_t pid = last_pid_;
+    if (auto current = query_window(window_id_)) {
+        pid = current->pid;
+    }
+    if (pid <= 0) {
+        LogError << "no target process for key_up" << VAR(key);
+        return false;
+    }
+    return post_key(pid, static_cast<CGKeyCode>(key), false);
+}
+
+bool HybridInput::scroll(int dx, int dy)
+{
+    // No captured point to scroll at has been validated for this profile yet; refuse rather than
+    // send a wheel event to whatever lies under a stale position.
+    LogError << "scroll is not supported by the hybrid input" << VAR(dx) << VAR(dy);
+    return false;
+}
+
+bool HybridInput::relative_move(int dx, int dy)
+{
+    auto pid = foreground_pid("relative_move");
+    if (!pid) {
+        return false;
+    }
+    CGEventRef current = CGEventCreate(nullptr);
+    CGPoint location = current ? CGEventGetLocation(current) : CGPointZero;
+    if (current) {
+        CFRelease(current);
+    }
+    // Posted to the process, the cursor stays where it is and the game turns the camera.
+    CGEventRef event = CGEventCreateMouseEvent(nullptr, kCGEventMouseMoved, location, kCGMouseButtonLeft);
+    if (!event) {
+        LogError << "failed to create mouse-moved event";
+        return false;
+    }
+    CGEventSetIntegerValueField(event, kCGMouseEventDeltaX, dx);
+    CGEventSetIntegerValueField(event, kCGMouseEventDeltaY, dy);
+    CGEventPostToPid(*pid, event);
+    CFRelease(event);
+    return true;
+}
+
+void HybridInput::release_all()
+{
+    for (int contact : std::set<int>(held_contacts_)) {
+        touch_up(contact);
+    }
+    for (int key : std::set<int>(held_keys_)) {
+        key_up(key);
+    }
+}
+
+MAA_CTRL_UNIT_NS_END
